<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>

    <!--
      B-TRC-01 — configuração de DEV do Traccar 6.16.0 (plano v2.1 §8.3 e §6.1; D-TRC-PD-APROVADA-2026-10-11).
      Montada somente leitura em /opt/traccar/conf/traccar.xml pelo docker-compose.traccar.yml.
      Sem segredo e sem URL: o FORWARD_URL e o FORWARD_HEADER entram por variável de ambiente
      (CONFIG_USE_ENVIRONMENT_VARIABLES=true no overlay). No B-TRC-01 só o OsmAnd, só em dev (v2.3 A-7).
    -->

    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password' />

    <entry key='protocols.enable'>osmand</entry>
    <entry key='osmand.port'>5055</entry>

    <entry key='forward.type'>json</entry>
    <entry key='forward.retry.enable'>true</entry>
    <entry key='client.connectTimeout'>5000</entry>
    <entry key='client.readTimeout'>5000</entry>

    <entry key='database.registerUnknown'>true</entry>
    <entry key='geocoder.enable'>false</entry>
    <entry key='web.address'>127.0.0.1</entry>

</properties>
