  created_by     String?            @db.Uuid
  updated_by     String?            @db.Uuid
  created_at     DateTime           @default(now()) @db.Timestamptz(6)
  updated_at     DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  tenant         Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  vehicle        Vehicle            @relation(fields: [tenant_id, vehicle_id], references: [tenant_id, id], onDelete: Restrict)
  // FK composta (tenant_id, responsible_operator_profile_id) → operator_profiles(tenant_id, id) RESTRICT.
  responsible_operator OperatorProfile? @relation(fields: [tenant_id, responsible_operator_profile_id], references: [tenant_id, id], onDelete: Restrict, map: "damages_responsible_operator_fkey")
  attachments    DamageAttachment[]

