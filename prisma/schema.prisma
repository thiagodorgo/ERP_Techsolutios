  settlement_ref       String?              @db.Uuid
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  basis_event          CommissionBasisEvent @relation(fields: [tenant_id, basis_event_id], references: [tenant_id, id], onDelete: Cascade)
  eligible_user        User?                @relation("CommissionCalculationEligibleUser", fields: [tenant_id, eligible_user_id], references: [tenant_id, id], onDelete: Restrict)
  payee                User?                @relation("CommissionCalculationPayee", fields: [tenant_id, payee_id], references: [tenant_id, id], onDelete: Restrict)
  policy               CommissionPolicy     @relation(fields: [tenant_id, policy_id], references: [tenant_id, id], onDelete: Restrict)
  tenant               Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@unique([tenant_id, idempotency_key])
  @@index([tenant_id])
  @@index([tenant_id, basis_event_id])
  @@index([tenant_id, policy_id])
  @@index([tenant_id, payee_id])
  @@index([tenant_id, status])
  // Ω4C PR-10 — grid de conferência filtra liquidado/não-liquidado; tenant_id 1º (isolamento multi-tenant).
  @@index([tenant_id, settled_at])
  @@map("commission_calculations")
}

