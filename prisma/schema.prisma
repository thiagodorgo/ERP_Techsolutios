model FuelLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String   @db.Uuid
  vehicle_id    String   @db.Uuid
  operator_id   String?  @db.Uuid
  work_order_id String?  @db.Uuid
  fueled_at     DateTime @db.Timestamptz(6)
  fuel_type     String   @default("gasolina")
  liters        Decimal   @db.Decimal(20, 6)
  total_value   Decimal   @db.Decimal(20, 6)
  odometer      Int
  station       String?
  // Ω4C PR-05 — MARCAÇÃO do posto (enum-app internal|external validado na app, SEM CHECK).
  // Default 'external' faz backfill semanticamente correto das linhas legadas (D-Ω4C-FUEL-STATION-TYPE).
  station_type  String    @default("external")
  // Ω4C PR-05 — fornecedor do abastecimento EXTERNO (nullable; INTERNO/legado ficam NULL).
  // FK COMPOSTA (tenant_id, supplier_id) -> suppliers RESTRICT (D-Ω4C-FUEL-SUPPLIER).
  supplier_id   String?   @db.Uuid
  // Ω4C PR-08b (D-Ω4C-INV-STOCK-DECREMENT) — QUAL item de estoque a baixa do abastecimento INTERNO consome
  // (nullable; externo/legado ficam NULL). FK COMPOSTA (tenant_id, stock_item_id) -> inventory_items RESTRICT:
  // item do MESMO tenant + RESTRICT protege item que ainda é fonte de baixa. A baixa em si é EFEITO DE DOMÍNIO
  // service→service (stock_movements type='saida', custódia BASE) — sem coluna de saldo aqui.
  stock_item_id String?   @db.Uuid
  notes         String?
  is_active     Boolean   @default(true)
  created_by    String?   @db.Uuid
  updated_by    String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  vehicle       Vehicle   @relation(fields: [tenant_id, vehicle_id], references: [tenant_id, id], onDelete: Restrict)
  supplier      Supplier? @relation(fields: [tenant_id, supplier_id], references: [tenant_id, id], onDelete: Restrict)
  stock_item    InventoryItem? @relation("FuelLogStockItem", fields: [tenant_id, stock_item_id], references: [tenant_id, id], onDelete: Restrict, map: "fuel_logs_stock_item_fkey")

  @@unique([tenant_id, id])
  @@index([tenant_id, vehicle_id, fueled_at])
  @@index([tenant_id, is_active])
  @@index([tenant_id, created_at])
  @@index([tenant_id, supplier_id])
  @@index([tenant_id, stock_item_id])
  @@map("fuel_logs")
}

model MaintenanceOrder {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.Uuid
  vehicle_id    String    @db.Uuid
  type          String
  status        String    @default("agendada")
  scheduled_for DateTime? @db.Timestamptz(6)
  completed_at  DateTime? @db.Timestamptz(6)
  cost          Decimal?  @db.Decimal(20, 6)
  supplier      String?
  odometer      Int?
  // Ω4C PR-06 — data prevista da PRÓXIMA manutenção, por TEMPO (D-Ω4C-MANUT-NEXTDUE-NOTIF). Nullable; quando
  // informada, o service dispara UMA ScheduledNotification via o motor PR-04 (dedupe por client_action_id
  // determinístico). Recorrência por KM = parada honesta D-007 → PR-16.
  next_due_at   DateTime? @db.Timestamptz(6)
  description   String
  is_active     Boolean   @default(true)
  created_by    String?   @db.Uuid
  updated_by    String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  vehicle       Vehicle   @relation(fields: [tenant_id, vehicle_id], references: [tenant_id, id], onDelete: Restrict)
  items         MaintenanceOrderItem[]

  @@unique([tenant_id, id])
  @@index([tenant_id, vehicle_id, status])
  @@index([tenant_id, status, scheduled_for])
  @@index([tenant_id, created_at])
  @@map("maintenance_orders")
}

model MaintenanceOrderItem {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String           @db.Uuid
  maintenance_order_id String           @db.Uuid
  item_type            String // service|product|stock (app-level, SEM CHECK; labels SERVIÇO/PRODUTO/ESTOQUE)
  description          String
  unit_value           Decimal          @db.Decimal(12, 2) // coluna NOVA (invariante 12,2), diferente do cost legado 20,6
  quantity             Decimal          @db.Decimal(10, 3)
  // Ω4C PR-08b (D-Ω4C-INV-STOCK-DECREMENT) — QUAL item de estoque a baixa do item Tipo=ESTOQUE consome (nullable;
  // service/product/legado ficam NULL). FK COMPOSTA (tenant_id, stock_item_id) -> inventory_items RESTRICT (item do
  // MESMO tenant + protege item que ainda é fonte de baixa). A baixa é EFEITO DE DOMÍNIO service→service.
  stock_item_id        String?          @db.Uuid
  notes                String?
  is_active            Boolean          @default(true)
  created_by           String?          @db.Uuid
  updated_by           String?          @db.Uuid
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at           DateTime?        @db.Timestamptz(6) // soft-delete = "excluir item"
  tenant               Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  maintenance_order    MaintenanceOrder @relation(fields: [tenant_id, maintenance_order_id], references: [tenant_id, id], onDelete: Restrict, map: "maintenance_order_items_order_fkey")
  stock_item           InventoryItem?   @relation("MaintenanceOrderItemStockItem", fields: [tenant_id, stock_item_id], references: [tenant_id, id], onDelete: Restrict, map: "maintenance_order_items_stock_item_fkey")

  // total_value da linha (unit_value × quantity) e os totais do cabeçalho são DERIVADOS server-side — NÃO há coluna.
  @@unique([tenant_id, id])
  @@index([tenant_id, maintenance_order_id], map: "maintenance_order_items_order_idx")
  @@index([tenant_id, maintenance_order_id, item_type], map: "maintenance_order_items_order_type_idx")
  @@index([tenant_id, stock_item_id])
  @@map("maintenance_order_items")
}

model Fine {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String    @db.Uuid
  vehicle_id      String    @db.Uuid
  driver_id       String?   @db.Uuid
  // Ω4C PR-07 (D-Ω4C-MULSEG-RESPONSIBLE-MODEL) — CONDUTOR RESPONSÁVEL do CTB/extrato = um
  // operator_profile (o profissional de campo que tem FOLHA), distinto de driver_id (User genérico,
  // INTOCADO). NULL = disposição "empresa paga" (contas a pagar); setado = "lançado no extrato".
  responsible_operator_profile_id String? @db.Uuid
  numero_auto     String
  data_infracao   DateTime  @db.Timestamptz(6)
  orgao           String
  descricao       String?
  valor           Decimal   @db.Decimal(20, 6)
  pontos          Int       @default(0)
  prazo_recurso   DateTime? @db.Timestamptz(6)
  prazo_pagamento DateTime? @db.Timestamptz(6)
  status          String    @default("recebida")
  is_active       Boolean   @default(true)
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant          Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  vehicle         Vehicle   @relation(fields: [tenant_id, vehicle_id], references: [tenant_id, id], onDelete: Restrict)
  // FK composta (tenant_id, responsible_operator_profile_id) → operator_profiles(tenant_id, id) RESTRICT.
  responsible_operator OperatorProfile? @relation(fields: [tenant_id, responsible_operator_profile_id], references: [tenant_id, id], onDelete: Restrict, map: "fines_responsible_operator_fkey")

  @@unique([tenant_id, id])
  @@unique([tenant_id, numero_auto])
  @@index([tenant_id, status, prazo_pagamento])
  @@index([tenant_id, vehicle_id])
  @@index([tenant_id, responsible_operator_profile_id], map: "fines_responsible_operator_idx")
  @@index([tenant_id, created_at])
  @@map("fines")
}

model InsurancePolicy {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
