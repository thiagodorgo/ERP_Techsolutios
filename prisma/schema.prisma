// Ω5P PR-01 — Pátio de recolhimento (local de guarda físico, Res. CONTRAN 1025/2026 art. 9º/14). Domínio
// FÍSICO net-new (Branch é organizacional, não físico — FASE0 §3-Alvo3). `branch_id` OPCIONAL herda o
// recorte organizacional. `timezone` é fundação DST-safe do motor de diárias (charging PR-07 lê daqui).
// `capacity_hint` é advisory — a capacidade REAL é COUNT(spots). Enums validados na APP (sem CHECK de enum
// no banco). tenant_id 1º em todo índice; RLS ENABLE+FORCE+policy na migração.
model Yard {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String     @db.Uuid
  branch_id     String?    @db.Uuid
  name          String
  address       String
  capacity_hint Int?
  timezone      String     @default("America/Sao_Paulo")
  active        Boolean    @default(true)
  created_by    String?    @db.Uuid
  updated_by    String?    @db.Uuid
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  tenant        Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  branch        Branch?    @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Restrict)
  areas         YardArea[]
  impound_processes ImpoundProcess[]

  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@index([tenant_id, active])
  @@index([tenant_id, branch_id])
  @@map("yards")
}

// Ω5P PR-01 — Área hierárquica do pátio (árvore quadra→corredor→fileira). Self-ref via parent_id (onDelete
// NoAction para o CASCADE do yard varrer a árvore num só statement). `kind` BLOCK|CORRIDOR|ROW e
// `vehicle_class` ANY|MOTORCYCLE|HEAVY validados na APP. A @@unique(tenant,yard,parent,name) é natural-key
// soft (NULLs distintos no Postgres — unicidade de nome no topo fica no guard app-level do validator).
model YardArea {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String     @db.Uuid
  yard_id       String     @db.Uuid
  parent_id     String?    @db.Uuid
  kind          String
  name          String
  covered       Boolean    @default(false)
  vehicle_class String     @default("ANY")
  created_by    String?    @db.Uuid
  updated_by    String?    @db.Uuid
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  tenant        Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  yard          Yard       @relation(fields: [tenant_id, yard_id], references: [tenant_id, id], onDelete: Cascade)
  parent        YardArea?  @relation("YardAreaTree", fields: [tenant_id, parent_id], references: [tenant_id, id], onDelete: NoAction)
  children      YardArea[] @relation("YardAreaTree")
  spots         YardSpot[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, yard_id, parent_id, name])
  @@index([tenant_id, yard_id])
  @@index([tenant_id, parent_id])
  @@map("yard_areas")
}

// Ω5P PR-01 — Vaga: a UNIDADE de ocupação (invariante I1). `current_process_id` SEM FK dura (o ImpoundProcess
// é PR-05; wire real no PR-06). I1 provado pela migração (índice PARCIAL único em (tenant,current_process_id)
// WHERE NOT NULL = I1b; + CHECK de coerência status⇄ocupação) + serviço transacional (SELECT ... FOR UPDATE +
// guarda de status = I1a). `code` único por área. Enums (status FREE|OCCUPIED|BLOCKED; vehicle_class) na APP.
model YardSpot {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String   @db.Uuid
  area_id            String   @db.Uuid
  code               String
  covered            Boolean  @default(false)
  vehicle_class      String   @default("ANY")
  status             String   @default("FREE")
  current_process_id String?  @db.Uuid
  created_by         String?  @db.Uuid
  updated_by         String?  @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant             Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  area               YardArea @relation(fields: [tenant_id, area_id], references: [tenant_id, id], onDelete: Cascade)
  // Ω5P PR-06 (D-Ω5P-REC-05) — FK DURA da ocupação: a vaga referencia o processo custodiado. Composta tenant-
  // first → impound_processes(tenant_id,id) RESTRICT (I9: processo com vaga não some). Aditiva NOT VALID+VALIDATE
  // na migração (current_process_id está NULL na base viva — a alocação só ganha wire HTTP neste PR).
  current_process    ImpoundProcess? @relation("YardSpotCurrentProcess", fields: [tenant_id, current_process_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@unique([tenant_id, area_id, code])
  @@index([tenant_id, status])
  @@index([tenant_id, area_id])
  @@map("yard_spots")
}

// Ω5P PR-02 — Perfil normativo (parametrização nacional white-label): prazos legais, modelo/teto de diária e
// checklist de liberação por natureza (convênio público × contrato privado). Fonte de verdade dos defaults
// federais (jurisdiction.defaults.ts) que o motor de diárias (charging PR-07, I4) e os relógios do leilão
// (auction/notificações PR-09/12, I6) leem. Enums em INGLÊS validados na APP (scope PUBLIC_AGREEMENT|
// PRIVATE_CONTRACT; daily_model ROLLING_24H|CALENDAR; daily_cap SIX_MONTHS|THIRTY_DAYS_LEGACY|UNLIMITED) —
// SEM CHECK de enum no banco; labels PT-BR no DTO. Prazos > 0 no app E CHECK estrutural na migração
// (D-Ω5P-JUR-05, belt-and-suspenders). release_requirements = checklist [{code,label,required}] app-validado.
// current: sem FK a partir do ImpoundProcess (PR-05, RN-JUR-01) — só forward-compat via @@unique([tenant_id,id]).
model JurisdictionProfile {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                   String   @db.Uuid
  name                        String
  scope                       String
  owner_notif_days            Int      @default(10)
  notice_edict_day            Int      @default(30)
  auction_eligible_day        Int      @default(60)
  auction_edict_business_days Int      @default(15)
  daily_model                 String   @default("ROLLING_24H")
  daily_cap                   String   @default("SIX_MONTHS")
  release_requirements        Json     @default("[]")
  // Ω5P PR-06 (D-Ω5P-REC-09) — conjuntos fotográficos OBRIGATÓRIOS da vistoria de recepção (I3), PARAMETRIZADOS
  // por perfil (não hardcode). Json array de SET codes (subconjunto de FRONT|REAR|LEFT|RIGHT|ROOF|DASH_PANEL|
  // ENGINE|CHASSIS_ID|ODOMETER|INNER_OBJECTS|DAMAGES), app-validado. NULL = default federal completo (a spec
  // federal de imagens ainda não saiu — ESTUDO §11a). Aditivo/nullable, sem default (retrocompat total).
  required_photo_sets         Json?
  // Ω5P PR-07 (D-Ω5P-CHG-01) — ponteiro ADITIVO/nullable ao serviço-tarifa "diária" que o motor de diárias I4
  // (charging) resolve por vigência×categoria×escopo. O PERFIL É o regime tarifário; NULL ⇒ fail-closed (não
  // cobra 0 em silêncio). FK composta tenant-first → service_catalog(tenant_id,id) RESTRICT. Mesmo trilho
  // ADD-COLUMN-nullable abençoado no PR-06 (required_photo_sets/custody_profile_id).
  daily_service_catalog_id    String?  @db.Uuid
  notes                       String?
  active                      Boolean  @default(true)
  created_by                  String?  @db.Uuid
  updated_by                  String?  @db.Uuid
  created_at                  DateTime @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant                      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  impound_processes           ImpoundProcess[]
  service_catalogs            ServiceCatalog[] @relation("ServiceCatalogCustodyProfile")
  daily_service_catalog       ServiceCatalog?  @relation("JurisdictionProfileDailyService", fields: [tenant_id, daily_service_catalog_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@index([tenant_id, scope])
  @@index([tenant_id, active])
  @@index([tenant_id, daily_service_catalog_id]) // Ω5P PR-07 — declara o índice que a migração cria (drift-zero, C2)
  @@map("jurisdiction_profiles")
}

// Ω5P PR-05 — Processo de custódia: agregado-raiz do domínio (ESTUDO §4.1). Identidade do bem de TERCEIRO
// NULLABLE e SEM FK ao Vehicle da frota (D-Ω5P-RECON-A / D-Ω5P-09: Vehicle.plate é NOT NULL+unique, impróprio
// para placa adulterada/ausente — a identidade vive AQUI). Origem NEUTRA white-label (autoridade/órgão/ato,
// NUNCA "polícia"). status = FSM §4.2 (14 estados) validada na APP (SEM enum-CHECK). entered_at = t0 do motor
// de diárias (I4); frozen_at = T_stop (PR-07/10/14). custody_seq_head/custody_hash_head = âncora da cadeia
// hash (I2). yard_id/service_order_id NULLABLE (wire real da alocação e do gatilho OS→custódia = PR-06);
// profile_id NOT NULL (perfil normativo PR-02 → teto/modelo de diária + prazos). Labels PT-BR no DTO.
model ImpoundProcess {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String    @db.Uuid
  vehicle_plate          String?
  vehicle_chassis        String?
  vehicle_renavam        String?
  vehicle_brand          String?
  vehicle_model          String?
  vehicle_color          String?
  vehicle_year           Int?
  vehicle_unidentified   Boolean   @default(false)
  unidentified_reason    String?
  yard_id                String?   @db.Uuid
  profile_id             String    @db.Uuid
  status                 String    @default("IN_REMOVAL")
  entered_at             DateTime? @db.Timestamptz(6)
  frozen_at              DateTime? @db.Timestamptz(6)
  origin_authority       String
  origin_agent_name      String?
  authority_case_number  String?
  incident_report_number String?
  legal_basis            String?
  service_order_id       String?   @db.Uuid
  custody_seq_head       Int       @default(0)
  custody_hash_head      String?
  created_by             String?   @db.Uuid
  updated_by             String?   @db.Uuid
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant                 Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  yard                   Yard?               @relation(fields: [tenant_id, yard_id], references: [tenant_id, id], onDelete: Restrict)
  profile                JurisdictionProfile @relation(fields: [tenant_id, profile_id], references: [tenant_id, id], onDelete: Restrict)
  service_order          WorkOrder?          @relation(fields: [tenant_id, service_order_id], references: [tenant_id, id], onDelete: Restrict)
  events                 CustodyEvent[]
  intake_inspection      IntakeInspection?   // Ω5P PR-06 — 1 vistoria de recepção por processo (I3)
  parked_spots           YardSpot[]          @relation("YardSpotCurrentProcess") // Ω5P PR-06 — FK dura da ocupação (I1)
  charges                ProcessCharge[]     // Ω5P PR-07 — ledger de encargos (diárias I4 + remoção/adicional/ajuste)
  notifications          ProcessNotification[] // Ω5P PR-09 — trilha de notificações legais (I6)
  releases               ImpoundRelease[]    // Ω5P PR-10a — liberações do veículo (I5)
  auction_attempts       AuctionAttempt[]    // Ω5P PR-12 — contador append-only de rodadas de leilão desertas (I8)
  auction_edicts         AuctionEdict[]      // Ω5P PR-13a — designação de leilão por rodada (projeção mutável; a prova vive na cadeia)
  settlements            Settlement[]        // Ω5P PR-14a — liquidação em cascata §6º (1 por processo; I7)
  settlement_allocations SettlementAllocation[] // Ω5P PR-14a — rateio append-only por beneficiário na ordem §6º

  @@unique([tenant_id, id])
  @@index([tenant_id, yard_id, status])
  @@index([tenant_id, vehicle_plate])
  @@index([tenant_id, status])
  @@map("impound_processes")
}

// Ω5P PR-05 — Evento de custódia: timeline APPEND-ONLY hash-encadeada (I2). hash = sha256 do preimage endurecido
// (prev_hash ‖ seq ‖ type ‖ canonicalJson(payload) ‖ occurred_at ‖ actor_id, SEP=0x1E; GENESIS amarrado a
// tenant+process — impound.hashchain.ts). Correção retroativa = novo evento ADJUSTMENT (NUNCA UPDATE/DELETE —
// I2/I9). process→RESTRICT (evento nunca cascateia; retenção ≥5 anos). @@unique(tenant,process,seq) = ordem
// contígua + backstop de corrida. A migração 20260836000000 adiciona TRIGGER BEFORE UPDATE OR DELETE
// (append-only ESTRUTURAL) + CHECKs (seq≥1, formato hex de hash/prev_hash) — belt-and-suspenders sobre a app.
model CustodyEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  process_id  String   @db.Uuid
  seq         Int
  type        String
  payload     Json
  occurred_at DateTime @db.Timestamptz(6)
  actor_id    String?  @db.Uuid
  prev_hash   String
  hash        String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  tenant      Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  process     ImpoundProcess @relation(fields: [tenant_id, process_id], references: [tenant_id, id], onDelete: Restrict)
  actor_user  User?          @relation("CustodyEventActor", fields: [tenant_id, actor_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@unique([tenant_id, process_id, seq])
  @@index([tenant_id, process_id, occurred_at])
  @@index([tenant_id, type])
  @@map("custody_events")
}

// Ω5P PR-06 — Vistoria de recepção (Res. CONTRAN 1025/2026 art. 9º I / art. 14 §1º/§2º): registro-PROVA do
// estado do bem na chegada. DEDICADA (não `checklists` genérico) → a guarda I3 (CUSTODIA_ATIVA só com vistoria
// completa) lê um estado determinístico in-module (D-Ω5P-REC-01). 1 vistoria por processo (@@unique tenant+
// process). Fotos = `Attachment` polimórfico REUSADO (entity_type="impound_intake_inspection", metadata.set =
// SET code app-validado no servidor) — zero tabela nova de foto. Cada foto + a marcação de completa entram na
// cadeia hash (PHOTO_SET / INSPECTION CustodyEvents). process→RESTRICT (I9). Enums (signature_status) validados
// na APP; labels PT-BR no DTO. odometer_km = km Decimal(10,1) (invariante da rodada). CHECKs estruturais na
// migração (completed⇒completed_by; odometer>=0) belt-and-suspenders sobre o validator.
model IntakeInspection {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String    @db.Uuid
  process_id        String    @db.Uuid
  inspected_at      DateTime  @db.Timestamptz(6)
  agent_name        String?
  bodywork_state    String?
  paint_state       String?
  tires_state       String?
  internal_objects  String?
  missing_equipment String?
  odometer_km       Decimal?  @db.Decimal(10, 1)
  observations      String?
  signer_name       String?
  signature_status  String    @default("ABSENT")
  signed_at         DateTime? @db.Timestamptz(6)
  completed_at      DateTime? @db.Timestamptz(6)
  completed_by      String?   @db.Uuid
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant            Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  process           ImpoundProcess @relation(fields: [tenant_id, process_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@unique([tenant_id, process_id])
  @@index([tenant_id, process_id])
  @@map("impound_intake_inspections")
}

// Ω5P PR-07 — LEDGER de encargos do processo de custódia (base de cálculo da guia + da quitação PR-10). É a
// materialização consultável do motor de diárias (I4); a PROVA de integridade vive no CustodyEvent CHARGE_ACCRUAL
// (append-only, trigger-protegido), escrito na MESMA tx do INSERT deste ledger. AMOUNT-IMUTÁVEL (RN-DIA-05 / I2):
// correção = novo ProcessCharge kind=ADJUSTMENT (delta com sinal), NUNCA UPDATE/DELETE de valor. settled_* só é
// carimbado na LIBERAÇÃO (PR-10) — NÃO escrito em PR-07. Dinheiro Decimal(12,2). kind/currency validados na APP
// (SEM enum-CHECK). process→RESTRICT (I9: encargo nunca cascateia; retenção ≥5 anos). tenant_id 1º; RLS forced.
// Idempotência da diária = índice PARCIAL único (tenant,process,period_seq) WHERE kind='DAILY' (raw-only na
// migração — D-Ω5P-CHG-02); a REMOVAL tem partial-unique próprio (no máx. 1 encargo-base por processo).
model ProcessCharge {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String    @db.Uuid
  process_id              String    @db.Uuid
  kind                    String                                     // REMOVAL|DAILY|ADDITIONAL|ADJUSTMENT (app-validado)
  period_seq              Int?                                       // só DAILY: ordinal N da diária (1-based) — chave de idempotência DST-imune
  ref_date                DateTime? @db.Date                         // data-local-do-pátio (DAILY: data do período; ADJUSTMENT: data corrigida)
  description             String?
  quantity                Decimal   @default(1) @db.Decimal(12, 2)   // §6.5 (DAILY=1)
  unit_amount             Decimal   @db.Decimal(12, 2)
  total_amount            Decimal   @db.Decimal(12, 2)               // = quantity × unit_amount (CHECK estrutural, relaxado p/ ADJUSTMENT)
  currency                String    @default("BRL")
  tariff_id               String?   @db.Uuid                         // proveniência SOFT (sem FK dura — padrão source_id da casa; tarifa arquiva)
  adjustment_of_charge_id String?   @db.Uuid                         // ADJUSTMENT: encargo corrigido (linkage append-only, soft)
  settled_at              DateTime? @db.Timestamptz(6)               // carimbo da LIBERAÇÃO (PR-10) — NÃO escrito em PR-07
  settlement_note         String?                                   // idem PR-10
  created_by              String?   @db.Uuid
  updated_by              String?   @db.Uuid
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant                  Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  process                 ImpoundProcess @relation(fields: [tenant_id, process_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@index([tenant_id, process_id])
  @@index([tenant_id, process_id, kind])
  @@index([tenant_id, kind])
  @@map("process_charges")
}

// Ω5P PR-07 — bookkeeping do SWEEP de diárias (durabilidade/observabilidade, NÃO a fonte de idempotência — essa
// é o partial-unique de period_seq). Um run por tick por tenant. tenant_id 1º; RLS forced.
model DailyAccrualRun {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String    @db.Uuid
  run_date        DateTime  @db.Date                    // data LÓGICA do sweep (≠ refDate por processo, que usa o TZ do pátio)
  status          String    @default("running")         // running|completed|failed (app-validado)
  processed_count Int       @default(0)                 // processos examinados
  accrued_count   Int       @default(0)                 // diárias criadas
  error_count     Int       @default(0)                 // fail-closed (sem tarifa / sem serviço-diária)
  started_at      DateTime  @default(now()) @db.Timestamptz(6)
  finished_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  tenant          Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@index([tenant_id, run_date])
  @@map("daily_accrual_runs")
}

// Ω5P PR-09 — Trilha de NOTIFICAÇÕES LEGAIS (I6): projeção consultável MUTÁVEL do rito administrativo do art. 328.
// Cada marco (notificação inicial ao proprietário, edital complementar) é MARCADO como DEVIDO (status=DUE) pelo
// SISTEMA no vencimento (t0 + prazo do JurisdictionProfile) e depois carimbado ISSUED/WAIVED por ato registrado
// (impound:notify). DUE→ISSUED carimba issued_at/channel — MESMO padrão de ProcessCharge.settled_* (metadado
// mutável). A PROVA de integridade vive no CustodyEvent NOTIFICATION (append-only, trigger-protegido), escrito na
// MESMA tx. kind/status/channel validados na APP (SEM enum-CHECK); labels PT-BR no DTO. process→RESTRICT (I9:
// notificação nunca cascateia; retenção ≥5 anos). recipient_ref = destinatário MINIMIZADO (§2.8: rótulo/máscara,
// NUNCA PII/endereço) e JAMAIS entra no payload do evento nem no audit. tenant_id 1º; RLS forced. Idempotência
// = índice único raw-only (tenant,process,kind) na migração (no máx. 1 notificação por kind por processo). CHECK
// estrutural: status ISSUED ⇒ issued_at E channel NOT NULL. AUCTION_EDICT é declarado no enum p/ o gate de leilão
// (PR-13), mas NÃO é agendado por PR-09 (relativo à data do certame, não ao t0).
model ProcessNotification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.Uuid
  process_id    String    @db.Uuid
  kind          String                                  // OWNER_INITIAL|COMPLEMENTARY_EDICT|AUCTION_EDICT (app-validado)
  status        String    @default("DUE")               // DUE|ISSUED|WAIVED|FAILED (app-validado)
  due_at        DateTime  @db.Timestamptz(6)            // instante em que passou a ser DEVIDA (t0 + prazo do perfil) — determinístico
  issued_at     DateTime? @db.Timestamptz(6)            // registro MANUAL de emissão efetiva (envio real = Ω6)
  channel       String?                                 // POSTAL|SNE|EDICT|IN_PERSON (app-validado) — só em ISSUED
  recipient_ref String?                                 // destinatário MINIMIZADO (allowlist §2.8: rótulo/máscara, NUNCA PII/endereço)
  reason        String?                                 // WAIVED/FAILED: fundamento (texto livre, sem PII)
  created_by    String?   @db.Uuid
  updated_by    String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant        Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  process       ImpoundProcess @relation(fields: [tenant_id, process_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@index([tenant_id, process_id])
  @@index([tenant_id, process_id, kind])
  @@index([tenant_id, status])
  @@map("process_notifications")
}

// Ω5P PR-10a — Liberação do veículo (CTB art. 271 §1º / Res. 1025 arts. 21 §2º/24; ESTUDO §4.3 I5): dossiê da
// restituição do bem ao proprietário/quem retira. É a materialização consultável do ato de liberação; a PROVA
// de integridade vive no CustodyEvent RELEASE (append-only, hash-encadeado I2), escrito na MESMA tx da consumação
// (RELEASE_IN_PROGRESS→RELEASED). recipient_* + authority_* são DADOS DE DOMÍNIO (RLS + permissão) e NUNCA entram
// no payload do evento nem no audit_logs (§2.8: o payload carrega só refs/hashes/settledTotal-string). settled_total
// = snapshot do total quitado na consumação. kind FOR_REPAIR (art. 271 §2º) é declarado AGORA p/ o PR-10b USÁ-LO —
// aditivo-friendly; PR-10a só produz STANDARD. Enums (kind/status/recipient_relationship) validados na APP (SEM
// enum-CHECK); labels PT-BR no DTO. process→RESTRICT (I9: liberação nunca cascateia; retenção >=5 anos). tenant_id
// 1º; RLS forced. Anti-dupla-liberação = índice PARCIAL único (tenant,process) WHERE status EM CURSO (raw-only na
// migração — D-Ω5P-REL-01). CHECK estrutural: COMPLETED ⇒ released_at E settled_total NOT NULL; aprovação ⇒ approver.
model ImpoundRelease {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String    @db.Uuid
  process_id             String    @db.Uuid
  kind                   String    @default("STANDARD")   // STANDARD|FOR_REPAIR (app-validado; PR-10a só STANDARD)
  status                 String    @default("IN_PROGRESS") // IN_PROGRESS|AUTHORIZED|COMPLETED|RETURNED (app-validado)
  authority_approved_by  String?   @db.Uuid               // ator do ato da autoridade (D-Ω5P-12); NUNCA no payload da cadeia
  authority_approved_at  DateTime? @db.Timestamptz(6)
  authority_reference    String?                          // nº do ato/decisão (white-label; mascarado no payload da cadeia)
  authority_note         String?
  recipient_name         String?                          // quem retira (§2.8: só na tabela de domínio, nunca no evento/audit)
  recipient_document     String?                          // idem — PII, jamais na cadeia hash nem no audit
  recipient_relationship String?                          // OWNER|ATTORNEY|THIRD_PARTY (app-validado)
  released_at            DateTime? @db.Timestamptz(6)      // saída/comprovante (art. 24) — carimbado na consumação
  repair_deadline        DateTime? @db.Timestamptz(6)     // art. 23 §1º <=60d — só FOR_REPAIR (PR-10b); NULL em PR-10a
  settled_total          Decimal?  @db.Decimal(12, 2)      // snapshot do total quitado (Decimal(12,2) — invariante)
  created_by             String?   @db.Uuid
  updated_by             String?   @db.Uuid
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant                 Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  process                ImpoundProcess @relation(fields: [tenant_id, process_id], references: [tenant_id, id], onDelete: Restrict)
  requirement_checks     ReleaseRequirementCheck[]

  @@unique([tenant_id, id])
  @@index([tenant_id, process_id])
  @@index([tenant_id, status])
  @@map("impound_releases")
}

// Ω5P PR-10a — Checklist de liberação (CTB art. 271 §1º / Res. 1025 arts. 23-24), SNAPSHOT do
// JurisdictionProfile.releaseRequirements no ATO de abertura da liberação (I9: a história congela mesmo se o
// perfil mudar depois). Cada requisito é marcado satisfied com quem/quando (+ nota/anexo opcional). A guarda I5
// da consumação exige que TODO requisito required=true esteja satisfied. release→RESTRICT (I9). tenant_id 1º; RLS
// forced. CHECK estrutural: satisfied=true ⇒ checked_at NOT NULL (IS NOT NULL explícito — lição PR-07 C1).
model ReleaseRequirementCheck {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.Uuid
  release_id    String    @db.Uuid
  code          String
  label         String
  required      Boolean   @default(true)
  satisfied     Boolean   @default(false)
  note          String?
  attachment_id String?   @db.Uuid                          // evidência via Attachment soft-link (entity_type=impound_release_requirement)
  checked_by    String?   @db.Uuid
  checked_at    DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant        Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  release       ImpoundRelease @relation(fields: [tenant_id, release_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@unique([tenant_id, release_id, code])
  @@index([tenant_id, release_id])
  @@map("release_requirement_checks")
}

// Ω5P PR-12 — CONTADOR de rodadas de leilão desertas (CTB art. 328 / Lei 13.160/2015 / Res. 1025 art. 25-26;
// ESTUDO §4.3 I8): registro APPEND-ONLY do resultado de cada rodada de certame externo homologado. O strikeCount é
// DERIVADO (COUNT(outcome='DESERTED')) — NUNCA uma coluna mutável em impound_processes. Na 2ª rodada deserta o
// processo é reclassificado AUCTION_ELIGIBLE→DIRECT_RECYCLING (sucata/reciclagem, sem retorno à circulação — I8). A
// PROVA de integridade de cada strike vive no CustodyEvent AUCTION_CLOSED (append-only, hash-encadeado I2), escrito
// na MESMA tx do INSERT; a reclassificação encadeia um STATUS_CHANGE na MESMA tx (frozen_at = T_stop, casa com o
// motor de diárias I4). outcome validado na APP (DESERTED|SOLD|NO_PAYMENT; PR-12 só grava DESERTED — SOLD/NO_PAYMENT
// declarados p/ o PR-13); SEM enum-CHECK; labels PT-BR no DTO. process→RESTRICT (I9: contador nunca cascateia;
// retenção >=5 anos). notes = texto de domínio (§2.8: sem PII; JAMAIS entra no payload da cadeia). tenant_id 1º; RLS
// forced. Idempotência = índice PARCIAL único raw-only (tenant,process,round_number) na migração (no máx. 1 registro
// por rodada). CHECK estrutural: round_number >= 1 (IS NOT NULL explícito — lição PR-07 C1).
model AuctionAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String   @db.Uuid
  process_id   String   @db.Uuid
  round_number Int                                       // rodada 1-based (chave de idempotência do fecho de rodada)
  outcome      String   @default("DESERTED")             // DESERTED|SOLD|NO_PAYMENT (app-validado; 13b grava SOLD/NO_PAYMENT)
  notes        String?                                   // texto de domínio (§2.8: sem PII; nunca no payload da cadeia)
  // Ω5P PR-13b — RESULTADO do certame ARREMATADO (nullable; só a linha SOLD carrega). winner_ref MINIMIZADO
  // (§2.8: rótulo/máscara, NUNCA CPF/nome). sold_amount = valor arrematado (BASE de I7 no PR-14, art. 328 §6º);
  // Decimal(12,2); auditável/imutável na cadeia (AUCTION_SOLD, string). sale_note_reference = ref da nota (art. 34;
  // assinatura ICP = Ω6). CHECK sold_amount IS NULL OR >= 0 (migração 20260843000000).
  winner_ref          String?                            // arrematante minimizado (§2.8; nunca CPF/nome)
  sold_amount         Decimal? @db.Decimal(12, 2)        // valor arrematado (base de I7 no PR-14)
  sale_note_reference String?                            // referência da nota de leilão (art. 34)
  // Ω5P PR-13b (MÉDIO-3) — só na linha NO_PAYMENT: a rodada da SOLD superada pela inadimplência (art. 42). Determina
  // a SOLD efetiva p/ o I7 do PR-14 (migração 20260844000000). CHECK defaulted_sale_round IS NULL OR >= 1.
  defaulted_sale_round Int?
  recorded_by  String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant       Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  process      ImpoundProcess @relation(fields: [tenant_id, process_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@index([tenant_id, process_id])
  @@index([tenant_id, process_id, outcome])
  @@map("auction_attempts")
}

// Ω5P PR-13a — DESIGNAÇÃO de leilão POR RODADA (edital do certame administrativo, CTB art. 328 / Lei 13.160/2015 /
// Res. CONTRAN 1025 arts. 25-34 / Lei 14.133 edital >=15 d.u.). Esta tabela é a PROJEÇÃO MUTÁVEL da designação —
// a PROVA de integridade vive na cadeia hash (CustodyEvents AUCTION_LOTTED/AUCTION_CLOSED, append-only I2). É o
// GATE probatório da sucata (I8): um strike DESERTED só conta se houve um certame REAL designado (edital registrado)
// para aquela rodada; a reciclagem AUCTION_ELIGIBLE→DIRECT_RECYCLING exige 2 strikes edict-backed (fecha
// R-omega5p-pr12-ciclo1). Enums em INGLÊS validados na APP (classification CONSERVED|SCRAP|UNRECOVERABLE; status
// DESIGNATED|CLOSED — SEM CHECK de enum no banco; labels PT-BR no DTO). appraisal_amount/min_bid_amount = avaliação
// SIGILOSA (art. 28) — NÃO povoadas em 13a (só emergem em 13b sob auction:appraise). Dinheiro Decimal(12,2).
// auctioneer_ref/notes minimizados (§2.8: sem PII; NUNCA no payload da cadeia). pncp_url = guard-rail p/ o adapter
// Ω6. process→RESTRICT (I9: designação nunca cascateia; retenção >=5 anos). tenant_id 1º em todo índice. RLS forced.
// Idempotência = índice PARCIAL único raw-only (tenant,process,round_number) WHERE round_number IS NOT NULL — 1
// edital/rodada (migração 20260842000000). CHECKs estruturais (IS NOT NULL explícito — lição PR-07 C1) belt-and-
// suspenders sobre o validator.
model AuctionEdict {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  process_id       String    @db.Uuid
  round_number     Int                                        // rodada 1-based (chave de idempotência: 1 edital/rodada)
  classification   String?                                    // CONSERVED|SCRAP|UNRECOVERABLE (app-validado)
  appraisal_amount Decimal?  @db.Decimal(12, 2)               // avaliação SIGILOSA art. 28 (13b sob auction:appraise)
  min_bid_amount   Decimal?  @db.Decimal(12, 2)               // lance mínimo (13b)
  edict_reference  String?                                    // referência pública do edital externo
  edict_platform   String?                                    // plataforma homologada do certame
  published_at     DateTime? @db.Timestamptz(6)
  auctioneer_ref   String?                                    // referência do leiloeiro (minimizado §2.8; nunca CPF/nome)
  pncp_url         String?                                    // guard-rail p/ o adapter PNCP (Ω6)
  business_days    Int?                                       // prazo do edital em dias úteis (>=15, Lei 14.133)
  status           String    @default("DESIGNATED")           // DESIGNATED|CLOSED (app-validado)
  notes            String?                                    // texto de domínio (§2.8: sem PII; nunca na cadeia)
  created_by       String?   @db.Uuid
  updated_by       String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant           Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  process          ImpoundProcess @relation(fields: [tenant_id, process_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@index([tenant_id, process_id])
  @@index([tenant_id, process_id, round_number])
  @@map("auction_edicts")
}

// Ω5P PR-14a — LIQUIDAÇÃO em cascata §6º (núcleo I7): distribuição do PRODUTO do leilão (hammer_amount = base
// findActiveSoldRound, NUNCA Σ sold_amount) na ORDEM LEGAL (CTB art. 328 §6º / Lei 13.160/2015 / Res. CONTRAN 1025
// arts. 25-39) + SALDO ao ex-dono (§12). 1 liquidação por processo (índice PARCIAL único raw-only tenant,process —
// migração 20260845000000). A PROVA da distribuição vive na cadeia hash (CustodyEvent AUCTION_SETTLEMENT, append-only
// I2), escrito na MESMA tx do INSERT. I7: Σ settlement_allocations.amount == hammer_amount (OWNER_BALANCE incluído).
// Dinheiro CENTAVOS INTEIROS EXATOS na app (nunca float); Decimal(12,2) no banco. status DISTRIBUTED|BALANCE_CLAIMED|
// BALANCE_REVERTED_FUNSET app-validado (14a só grava DISTRIBUTED; o ciclo do saldo é 14b). owner_notify_due_at
// (+30d) / owner_claim_expires_at (+5a) = janela do saldo ao ex-dono (§12). process→RESTRICT (I9). tenant_id 1º; RLS
// forced. CHECK estrutural hammer_amount >= 0 (IS NOT NULL explícito — lição PR-07 C1).
model Settlement {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String                 @db.Uuid
  process_id             String                 @db.Uuid
  sold_round             Int?                                        // rodada da SOLD efetiva (findActiveSoldRound; base de I7)
  hammer_amount          Decimal                @db.Decimal(12, 2)   // produto do leilão (base I7; soldAmount da SOLD efetiva)
  auction_cost_amount    Decimal?               @db.Decimal(12, 2)   // custeio do leilão declarado (tier topo §6º)
  removal_storage_claim  Decimal?               @db.Decimal(12, 2)   // item I remoção/estada COMPUTADO (charging capado I4)
  owner_balance_amount   Decimal?               @db.Decimal(12, 2)   // saldo ao ex-dono = resíduo (§12)
  shortfall_amount       Decimal?               @db.Decimal(12, 2)   // Σclaims − hammer (informativo; não é allocation)
  currency               String                 @default("BRL")
  status                 String                 @default("DISTRIBUTED") // DISTRIBUTED|BALANCE_CLAIMED|BALANCE_REVERTED_FUNSET
  owner_notify_due_at    DateTime?              @db.Timestamptz(6)   // notificar o ex-dono do saldo <=30d (§12)
  owner_claim_expires_at DateTime?              @db.Timestamptz(6)   // saldo disponível 5 anos; depois Funset (§12; 14b)
  distributed_by         String?                @db.Uuid
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  tenant                 Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  process                ImpoundProcess         @relation(fields: [tenant_id, process_id], references: [tenant_id, id], onDelete: Restrict)
  allocations            SettlementAllocation[]

  @@unique([tenant_id, id])
  @@index([tenant_id, process_id])
  @@map("settlements")
}

// Ω5P PR-14a — RATEIO append-only da liquidação por beneficiário na ordem §6º (order_seq 1-based). beneficiary_kind
// (app-validado; INGLÊS, labels PT-BR no DTO): AUCTION_COST/REMOVAL_STORAGE/VEHICLE_TAXES/PRIORITY_CREDITORS/
// REALIZING_AGENCY_FINES/OTHER_SNT_FINES/OTHER_DEBITS/OWNER_BALANCE/FUNSET. amount = valor ALOCADO (min(remaining,
// claim), centavo exato); claim_amount = valor RECLAMADO do tier (nullable; OWNER_BALANCE não tem claim). reference
// = rótulo MASCARADO (§2.8: NUNCA CPF/nome de credor/arrematante). I7: Σ amount == settlement.hammer_amount. 1 linha
// por (settlement, order_seq) — índice PARCIAL único raw-only (migração 20260845000000). settlement/process→RESTRICT
// (I9). tenant_id 1º; RLS forced. CHECK estrutural order_seq >= 1 / amount >= 0 (IS NOT NULL explícito).
model SettlementAllocation {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String         @db.Uuid
  settlement_id    String         @db.Uuid
  process_id       String         @db.Uuid
  order_seq        Int                                            // posição 1-based na cascata §6º
  beneficiary_kind String                                         // tier do §6º (app-validado; OWNER_BALANCE = resíduo)
  amount           Decimal        @db.Decimal(12, 2)              // valor ALOCADO (centavo exato; Σ == hammer_amount)
  claim_amount     Decimal?       @db.Decimal(12, 2)              // valor RECLAMADO do tier (OWNER_BALANCE = NULL)
  reference        String?                                        // rótulo mascarado (§2.8: nunca PII de credor/arrematante)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  tenant           Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  settlement       Settlement     @relation(fields: [tenant_id, settlement_id], references: [tenant_id, id], onDelete: Restrict)
  process          ImpoundProcess @relation(fields: [tenant_id, process_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@index([tenant_id, settlement_id, order_seq])
  @@map("settlement_allocations")
}
