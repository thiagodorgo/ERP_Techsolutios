  status          String   @default("vigente")
  is_active       Boolean  @default(true)
  created_by      String?  @db.Uuid
  updated_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant          Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  vehicle         Vehicle  @relation(fields: [tenant_id, vehicle_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@unique([tenant_id, numero_apolice])
  @@index([tenant_id, status, vigencia_fim])
  @@index([tenant_id, vehicle_id])
  @@index([tenant_id, created_at])
  @@map("insurance_policies")
}

model Damage {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String             @db.Uuid
  vehicle_id     String             @db.Uuid
  work_order_id  String?            @db.Uuid
  // Ω4C PR-09 (D-Ω4C-DANO-MODEL) — PROFISSIONAL RESPONSÁVEL (quem sofreu/causou o dano) = um
  // operator_profile (o profissional de campo que tem FOLHA). Quando setado E há valor a cobrar, o
  // desconto vira débito PARCELADO no extrato desse profissional (rail interno da PR-03; RN-EXT-01).
  // NULL = sem responsável. Espelha fines.responsible_operator_profile_id (20260827000000).
  responsible_operator_profile_id String? @db.Uuid
  data           DateTime           @db.Timestamptz(6)
  gravidade      String
  descricao      String
  status         String             @default("registrado")
  // Ω4C PR-09 — campos DESCRITIVOS do dano (display/impressão; sem regra além do parseamento). tipo =
  // enum-app internal|external|both (labels INTERNO/EXTERNO/AMBOS, SEM CHECK). origem = classificação
  // string (MULTA entre os valores, SEM FK — D-Ω4C-RECON-04). analise_interna NUNCA é impressa (ANALISE:126).
  tipo                 String?
  origem               String?
  objeto               String?
  identificacao_objeto String?
  analise_interna      String?
  custo_estimado Decimal?           @db.Decimal(20, 6)
