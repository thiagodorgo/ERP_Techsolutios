// Ω3-d — Anexo de OS (evidência/documento). Espelha DamageAttachment (storage/DTO), REUSA o
// checklist storage provider (D-014). Net-new: `status` (reserva AV-assíncrono/B-108; default 'stored'),
// `client_action_id` (idempotência tenant-scoped — §6) e `deleted_at` (delete LÓGICO). storage_key/
// provider/checksum são INTERNOS (nunca no DTO — §2.8).
model WorkOrderAttachment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  work_order_id    String    @db.Uuid
  file_url         String
  file_name        String?
  mime_type        String?
  size_bytes       Int?
  checksum_sha256  String?
  storage_provider String?
  storage_key      String?
  status           String    @default("stored")
  client_action_id String?
  metadata         Json
  uploaded_by      String?   @db.Uuid
  created_by       String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)
  work_order       WorkOrder @relation(fields: [tenant_id, work_order_id], references: [tenant_id, id], onDelete: Cascade)
  tenant           Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@index([tenant_id, work_order_id])
  @@index([tenant_id, status])
  @@map("work_order_attachments")
}

// Ω4C PR-01 — Anexo genérico POLIMÓRFICO (aba "Arquivos"). COEXISTÊNCIA ADITIVA: NÃO substitui
// WorkOrderAttachment/DamageAttachment/ChecklistAttachment (que seguem vivos). Espelha
// WorkOrderAttachment trocando a FK à OS pelo par polimórfico (entity_type app-enum em inglês +
// entity_id). storage_key/provider/checksum/file_url são INTERNOS (nunca no DTO — §2.8). `status`
// reserva o AV-assíncrono (default 'stored'); `client_action_id` = idempotência TENANT-SCOPED (§6);
// `deleted_at` = delete lógico. Posse e RBAC são HERDADAS da entidade-alvo via resolver
// (D-Ω4C-ANEXOS-RBAC) — o get() de cada módulo já dá 404 cross-tenant.
model Attachment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  entity_type      String
  entity_id        String    @db.Uuid
  file_name        String?
  extension        String?
  content_type     String?
  size_bytes       Int?
  checksum_sha256  String?
  storage_provider String?
  storage_key      String?
  file_url         String
  status           String    @default("stored")
  client_action_id String?
  metadata         Json
  uploaded_by      String?   @db.Uuid
  created_by       String?   @db.Uuid
  uploaded_at      DateTime  @default(now()) @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)
  tenant           Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@index([tenant_id, entity_type, entity_id])
  @@index([tenant_id, status])
  @@map("attachments")
}

model DamageAttachment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String   @db.Uuid
  damage_id        String   @db.Uuid
  file_url         String
  file_name        String?
  mime_type        String?
  size_bytes       Int?
  checksum_sha256  String?
  storage_provider String?
  storage_key      String?
  marker           Json?
  metadata         Json
  created_by       String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  damage           Damage   @relation(fields: [tenant_id, damage_id], references: [tenant_id, id], onDelete: Cascade)
  tenant           Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@index([tenant_id, damage_id])
  @@map("damage_attachments")
}

/// F7a (Estoque core) — catalog item. The BALANCE IS NEVER A COLUMN (R7.1):
/// saldo = SUM(stock_movements.quantidade_sinalizada) computed in a transaction.
/// `avg_cost` is the moving average recalculated on `entrada` (R7.3); `abc_class`
/// is populated by the F7b ABC job (schema-only in F7a — no API write).
model InventoryItem {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String            @db.Uuid
  sku                 String
  name                String
  unit                String
  min_quantity        Decimal           @default(0) @db.Decimal(20, 6)
  max_quantity        Decimal?          @db.Decimal(20, 6)
  abc_class           String?
  avg_cost            Decimal           @default(0) @db.Decimal(20, 6)
  lead_time_days      Int?
  safety_stock        Decimal?          @db.Decimal(20, 6)
  is_active           Boolean           @default(true)
  // Ω4C PR-08 (D-Ω4C-INV-ITEM-FIELDS) — campos AutEM do item (aditivos, completam a aba Editar). `is_fuel` = o
  // checkbox "Combustível" (habilita o item no Abastecimento interno; é o contrato que PR-08b lê para a baixa
  // automática). `item_type` enum-app product|equipment (labels PRODUTO/EQUIPAMENTO, SEM CHECK; EQUIPAMENTO
  // oculta Compra/Venda no front). `purchase_price`/`sale_price` são atributos do item (só PRODUTO) e seguem a
  // invariante Decimal(12,2) — distintos do `avg_cost` legado (20,6), cuja precisão não é alterada (§C7.5).
  is_fuel             Boolean           @default(false)
  item_type           String            @default("product")
  purchase_price      Decimal?          @db.Decimal(12, 2)
  sale_price          Decimal?          @db.Decimal(12, 2)
  description         String?
  created_by          String?           @db.Uuid
  updated_by          String?           @db.Uuid
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  tenant              Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  movements           StockMovement[]
  cycle_count_entries CycleCountEntry[]
  // Ω4C PR-08b — back-relations das baixas automáticas (item consumido no abastecimento INTERNO / item ESTOQUE).
  fuel_logs           FuelLog[]              @relation("FuelLogStockItem")
  maintenance_items   MaintenanceOrderItem[] @relation("MaintenanceOrderItemStockItem")

  @@unique([tenant_id, id])
  @@unique([tenant_id, sku])
  @@index([tenant_id, is_active])
  @@index([tenant_id, created_at])
  @@map("inventory_items")
}

/// F7a (Estoque core) — IMMUTABLE stock ledger entry (no update/delete surface).
/// `quantidade_sinalizada` is stored SIGNED: + for entrada / positive ajuste,
/// − for saida / consumo / negative ajuste. `work_order_id` (required for
/// consumo, R7.2) and `vehicle_id` are validated in-tenant at the service layer
/// (no hard FK); `cycle_count_id` is a plain column — F7b adds the table.
model StockMovement {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String        @db.Uuid
  item_id               String        @db.Uuid
  type                  String
  quantidade_sinalizada Decimal       @db.Decimal(20, 6)
  unit_cost             Decimal?      @db.Decimal(20, 6)
  work_order_id         String?       @db.Uuid
  vehicle_id            String?       @db.Uuid
  reason                String?
  cycle_count_id        String?       @db.Uuid
  // Ω4C PR-08 (D-Ω4C-INV-CUSTODY-MODEL) — a custódia BASE/PROFISSIONAL/VIATURA viaja no próprio movimento;
  // saldo(item,custódia) = Σ quantidade_sinalizada filtrada por custódia (DERIVADO, nunca coluna). Enum-app
  // custody_type base|professional|vehicle (labels BASE/PROFISSIONAL/VIATURA, SEM CHECK — validado na app).
  // Default 'base' backfilla o legado semanticamente (era estoque da base). LINK/UNLINK = par irmão via
  // `transfer_group_id`; estorno = movimento compensatório via `reverses_movement_id` (app-level, SEM FK
  // nativa — como source_id). custody_vehicle_id (custódia DETIDA por viatura) é DISTINTO do vehicle_id legado
  // (movimento ATRIBUÍDO a viatura) — colunas/semânticas distintas, coexistência documentada (D-007).
  custody_type          String        @default("base")
  custody_operator_profile_id String? @db.Uuid
  custody_vehicle_id    String?       @db.Uuid
  transfer_group_id     String?       @db.Uuid
  reverses_movement_id  String?       @db.Uuid
  // Ω4C PR-08b (D-Ω4C-INV-MOVEMENT-SOURCE) — proveniência GENÉRICA da baixa automática (fuel_log|maintenance_item).
  // Ambos nullable, SEM FK nativa ao alvo variável (integridade app-level, como source_id de financial_titles). A
  // idempotência POR ORIGEM (no MÁX. 1 movimento por tenant+source_type+source_id) é um índice PARCIAL UNIQUE
  // (WHERE source_id IS NOT NULL) que o Prisma NÃO modela; vive só na migration 20260832000000
  // (stock_movements_source_active_key). O estorno compensatório carrega source_id NULL (fora do índice).
  source_type           String?
  source_id             String?       @db.Uuid
  created_by            String?       @db.Uuid
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  tenant                Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  item                  InventoryItem @relation(fields: [tenant_id, item_id], references: [tenant_id, id], onDelete: Restrict)
  cycle_count           CycleCount?   @relation(fields: [tenant_id, cycle_count_id], references: [tenant_id, id], onDelete: Restrict)
  // Ω4C PR-08 — FK COMPOSTAS RESTRICT tipadas da custódia (D-Ω4C-INV-CUSTODY-REF-TYPED): integridade real
  // (cross-tenant → 23503) + RESTRICT protege profissional/viatura que AINDA detém saldo (desvincular devolve
  // à base antes de remover). Duas colunas de ref tipadas em vez de um custody_ref_id polimórfico (que não
  // poderia ter FK nativa). Ambas nullable; base → ambas NULL (FK não checada com MATCH SIMPLE).
  custody_operator_profile OperatorProfile? @relation("StockMovementCustodyOperator", fields: [tenant_id, custody_operator_profile_id], references: [tenant_id, id], onDelete: Restrict, map: "stock_movements_custody_operator_fkey")
  custody_vehicle       Vehicle?      @relation("StockMovementCustodyVehicle", fields: [tenant_id, custody_vehicle_id], references: [tenant_id, id], onDelete: Restrict, map: "stock_movements_custody_vehicle_fkey")

  @@unique([tenant_id, id])
  @@index([tenant_id, item_id, created_at])
  @@index([tenant_id, work_order_id])
  @@index([tenant_id, created_at])
  @@index([tenant_id, item_id, custody_type, custody_operator_profile_id, custody_vehicle_id], map: "stock_movements_custody_lookup_idx")
  @@index([tenant_id, transfer_group_id], map: "stock_movements_tenant_id_transfer_group_id_idx")
  @@index([tenant_id, reverses_movement_id], map: "stock_movements_tenant_id_reverses_movement_id_idx")
  @@map("stock_movements")
}

/// F7b (Estoque avançado) — contagem cíclica SESSION (R7.6). Snapshots the derived
/// saldo of the chosen `abc_class` (or all active items) into `entries` at open,
/// then generates `ajuste` movements for the variances at close. `status`
/// ('aberta'|'concluida'|'cancelada') is terminal once concluida/cancelada
/// (further mutation = 422). The saldo is NEVER stored here — only the snapshot.
model CycleCount {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String            @db.Uuid
  abc_class  String?
  status     String            @default("aberta")
  notes      String?
  is_active  Boolean           @default(true)
  created_by String?           @db.Uuid
  updated_by String?           @db.Uuid
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  updated_at DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  tenant     Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  entries    CycleCountEntry[]
  movements  StockMovement[]

  @@unique([tenant_id, id])
  @@index([tenant_id, status])
  @@index([tenant_id, is_active])
  @@index([tenant_id, created_at])
  @@map("cycle_counts")
}

/// F7b (Estoque avançado) — counted line of a `CycleCount`. `system_quantity` is
/// the derived saldo snapshotted at open; `counted_quantity` is filled while
/// counting; `variance` (counted − system) and `adjustment_movement_id` (the
/// generated `ajuste`) are filled at close. One line per item per session.
model CycleCountEntry {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String        @db.Uuid
  cycle_count_id         String        @db.Uuid
  item_id                String        @db.Uuid
  system_quantity        Decimal       @db.Decimal(20, 6)
  counted_quantity       Decimal?      @db.Decimal(20, 6)
  variance               Decimal?      @db.Decimal(20, 6)
  adjustment_movement_id String?       @db.Uuid
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  tenant                 Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  cycle_count            CycleCount    @relation(fields: [tenant_id, cycle_count_id], references: [tenant_id, id], onDelete: Cascade)
  item                   InventoryItem @relation(fields: [tenant_id, item_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@unique([tenant_id, cycle_count_id, item_id])
  @@index([tenant_id, cycle_count_id])
  @@index([tenant_id, item_id])
  @@map("cycle_count_entries")
}

model ServiceCatalog {
  id                         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                  String      @db.Uuid
  name                       String
  description                String?
  category                   String?
  // Ω3F-2 (C4) — discriminador de tipo: dirige os campos dinâmicos do form (#23) e o 422 de destino (#24).
  // Soft-enum String (reboque|socorro|residencial|outro), NÃO enum Prisma — tipos são configuráveis por
  // organização (spec §1.2). requires_destination separado para o cliente decidir por tipo. Aditivo/nullable.
  service_type               String?
  requires_destination       Boolean     @default(false)
  // Ω5P PR-06 (D-Ω5P-REC-04) — gatilho OS→custódia ORIGEM-AGNÓSTICO. Nomeia o perfil normativo da custódia que
  // a OS de remoção CONCLUÍDA abre (custody_profile_id IS NOT NULL = "esta OS abre custódia"). FK composta
  // nullable → jurisdiction_profiles(tenant_id,id) RESTRICT. NULL = a OS não abre custódia (retrocompat total,
  // regressão ZERO). Esta coluna é o ÚNICO marcador de "abre custódia": não há sinal INDEPENDENTE de "remoção"
  // no modelo (service_type é soft-enum configurável por org; WorkOrder não tem flag de remoção) — a abertura é
  // 100% contingente a esta config, então o sweep `impound.reconcile-removals` simplesmente NÃO abre custódia
  // para OS sem custody_profile_id (não há "lacuna" observável a registrar — F-2).
  custody_profile_id         String?     @db.Uuid
  estimated_duration_minutes Int?
  base_price                 Decimal?    @db.Decimal(12, 2)
  status                     String      @default("active")
  is_active                  Boolean     @default(true)
  created_by                 String?     @db.Uuid
  updated_by                 String?     @db.Uuid
  created_at                 DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  tenant                     Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  work_orders                WorkOrder[] @relation("WorkOrderServiceCatalog")
  tariffs                    Tariff[]    @relation("TariffService")
  custody_profile            JurisdictionProfile? @relation("ServiceCatalogCustodyProfile", fields: [tenant_id, custody_profile_id], references: [tenant_id, id], onDelete: Restrict)
  daily_jurisdiction_profiles JurisdictionProfile[] @relation("JurisdictionProfileDailyService") // Ω5P PR-07 — serviço-tarifa "diária" de perfis

  @@unique([tenant_id, id])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active])
  @@index([tenant_id, created_at])
  @@index([tenant_id, custody_profile_id])
  @@map("service_catalog")
}

// Ω2-a.1 — Tabela de Valores (contêiner versionado, RN-CAD-007/008). status: draft|published|archived.
model PriceTable {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  name        String
  description String?
  currency    String    @default("BRL")
  version     Int       @default(1)
  valid_from  DateTime? @db.Timestamptz(6)
  valid_to    DateTime? @db.Timestamptz(6)
  status      String    @default("draft")
  is_active   Boolean   @default(true)
  // Ω5P PR-03 (D-Ω5P-TAR-01/02) — dupla natureza tarifária (ESTUDO §9) + eixo categoria-de-veículo (FASE0 §5e).
  // Ambos NULLABLE, sem default. scope reusa o MESMO enum de JurisdictionProfile.scope (PUBLIC_AGREEMENT|
  // PRIVATE_CONTRACT), app-validado — NULL = vale para os dois. vehicle_category = app-code parametrizado
  // por perfil (MOTORCYCLE|CAR|TRUCK|...), app-validado — NULL = vale para todas as categorias. Legado (NULL,
  // NULL) = curinga vale-para-todos → resolveTariff resolve idêntico (retrocompat total, regressão ZERO).
  scope            String?
  vehicle_category String?
  created_by  String?   @db.Uuid
  updated_by  String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  tariffs Tariff[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active])
  @@index([tenant_id, status])
  @@index([tenant_id, created_at])
  // Ω5P PR-03 — suporta a resolução escopada publicada×escopo×categoria (equality-prefix); tenant_id 1º.
  @@index([tenant_id, status, scope, vehicle_category])
  @@map("price_tables")
}

// Ω2-a.2 — Tarifa (item de preço), pertence a uma Tabela de Valores. RN-CAD-009.
model Tariff {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String          @db.Uuid
  price_table_id     String          @db.Uuid
  service_catalog_id String?         @db.Uuid
  customer_id        String?         @db.Uuid
  name               String?
  unit_price         Decimal         @db.Decimal(12, 2)
  currency           String          @default("BRL")
  origin             String
  rule               String?
  valid_from         DateTime?       @db.Timestamptz(6)
  valid_to           DateTime?       @db.Timestamptz(6)
  status             String          @default("active")
  is_active          Boolean         @default(true)
  created_by         String?         @db.Uuid
  updated_by         String?         @db.Uuid
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  tenant             Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  price_table        PriceTable      @relation(fields: [tenant_id, price_table_id], references: [tenant_id, id], onDelete: Cascade)
  service_catalog    ServiceCatalog? @relation("TariffService", fields: [tenant_id, service_catalog_id], references: [tenant_id, id], onDelete: Restrict)
  customer           Customer?       @relation("TariffCustomer", fields: [tenant_id, customer_id], references: [tenant_id, id], onDelete: Restrict)

  // A1 (crítico) — chave natural INCLUI customer_id: tarifa padrão (customer NULL) e por-cliente
  // para o mesmo serviço NÃO colidem (NULLs distintos no índice único do Postgres).
  @@unique([tenant_id, price_table_id, service_catalog_id, customer_id])
  @@unique([tenant_id, id])
  @@index([tenant_id, price_table_id])
  @@index([tenant_id, is_active])
  @@map("tariffs")
}

// Ω3-a — ServiceQuote (orçamento): CONGELA preço unitário + total a partir de uma Tarifa de Tabela de
// Valores PUBLICADA, no momento da criação (anti-refaturamento). `source_*` = rastreabilidade apenas
// (nunca relidos para recalcular). Colunas ESCALARES no Prisma; as FKs compostas (tenant_id, X) e o
// índice único PARCIAL da chave natural ativa (WHERE is_active AND status<>'void') são criados em SQL
// bruto na migration — C1 (crítico): a chave natural NÃO pode ser @@unique CHEIO do Prisma, senão
// bloquearia re-orçar após void. RLS ENABLE+FORCE+policy em app.current_tenant_id (SQL bruto).
model ServiceQuote {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String    @db.Uuid
  work_order_id         String?   @db.Uuid
  customer_id           String?   @db.Uuid
  service_catalog_id    String    @db.Uuid
  source_tariff_id      String?   @db.Uuid
  source_price_table_id String?   @db.Uuid
  frozen_unit_price     Decimal   @db.Decimal(12, 2)
  frozen_currency       String    @default("BRL")
  quantity              Decimal   @default(1) @db.Decimal(12, 2)
  frozen_total          Decimal   @db.Decimal(12, 2)
  frozen_at             DateTime  @default(now()) @db.Timestamptz(6)
  price_source          String    @default("tariff")
  status                String    @default("draft")
  is_active             Boolean   @default(true)
  notes                 String?
  // Ω3F-4a — cabeçalho do orçamento multi-item (aditivos/nullable; item único legado permanece válido).
  number                String?
  issued_at             DateTime? @db.Timestamptz(6)
  valid_until           DateTime? @db.Timestamptz(6)
  // Ω3F-4b — aprovar→cria OS (idempotência ancorada aqui: um orçamento gera no máx. UMA OS) e compartilhar.
  created_work_order_id String?   @db.Uuid
  share_token           String?
  created_by            String?   @db.Uuid
  updated_by            String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([tenant_id, id])
  @@index([tenant_id, work_order_id])
  @@index([tenant_id, status])
  @@map("service_quotes")
}

// Ω3F-4a — item (linha) do orçamento multi-item. Espelho 1:1 de WorkOrderFinancialItem (source+description,
// NÃO kind — reuso do shape C3 e do congelamento). CONGELA unit_amount/total_amount a partir da Tarifa
// vigente do cliente (leitura única, anti-refaturamento) ou valor manual. Delete LÓGICO. Idempotência
// tenant-scoped por client_action_id (unique parcial em SQL bruto na migration). FKs compostas RESTRICT + RLS.
model ServiceQuoteItem {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  service_quote_id String    @db.Uuid
  tariff_id        String?   @db.Uuid
  price_table_id   String?   @db.Uuid
  description      String
  quantity         Decimal   @default(1) @db.Decimal(12, 2)
  unit_amount      Decimal   @db.Decimal(12, 2)
  total_amount     Decimal   @db.Decimal(12, 2)
  currency         String    @default("BRL")
  source           String    @default("tariff")
  notes            String?
  client_action_id String?
  created_by       String?   @db.Uuid
  updated_by       String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)

  @@unique([tenant_id, id])
  @@index([tenant_id, service_quote_id])
  @@map("service_quote_items")
}

// Ω3F-3a — WorkOrderFinancialItem (Financeiro da OS): item lançado que CONGELA unit_amount +
// total_amount no momento do lançamento — source=tariff resolve a Tarifa vigente (a MESMA máquina
// do orçamento) numa ÚNICA leitura; source=manual usa o valor do corpo. tariff_id/price_table_id =
// proveniência apenas (JAMAIS relidos para recalcular — anti-refaturamento). Delete LÓGICO via
// deleted_at. Colunas ESCALARES no Prisma (espelho do ServiceQuote); as FKs compostas (tenant_id, X)
// RESTRICT, o unique PARCIAL de idempotência (tenant_id, work_order_id, client_action_id WHERE
// client_action_id IS NOT NULL AND deleted_at IS NULL) e o RLS ENABLE+FORCE+policy são SQL bruto na
// migration (não expressáveis no schema).
model WorkOrderFinancialItem {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String          @db.Uuid
  work_order_id    String          @db.Uuid
  tariff_id        String?         @db.Uuid
  price_table_id   String?         @db.Uuid
  description      String
  quantity         Decimal         @default(1) @db.Decimal(12, 2)
  unit_amount      Decimal         @db.Decimal(12, 2)
  total_amount     Decimal         @db.Decimal(12, 2)
  currency         String          @default("BRL")
  source           String          @default("tariff")
  notes            String?
  client_action_id String?
  // Ω4-3 (D-Ω4-C1) — carimbo de faturamento. invoiced_at != NULL trava PATCH/DELETE do item (422
  // item_invoiced, app-level). title_id aponta o Título gerado via FK composta RESTRICT (só no SQL da
  // migration 20260811000000; o relation abaixo dá acesso tipado). Aditivo/nullable (item não-faturado =
  // ambos NULL).
  invoiced_at      DateTime?       @db.Timestamptz(6)
  title_id         String?         @db.Uuid
  created_by       String?         @db.Uuid
  updated_by       String?         @db.Uuid
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?       @db.Timestamptz(6)
  title            FinancialTitle? @relation(fields: [tenant_id, title_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@index([tenant_id, work_order_id])
  @@map("work_order_financial_items")
}

// Ω3F-5 (D-Ω3F-5-COMMENT) — comentário do usuário como AGREGADO PRÓPRIO mutável (deixa WorkOrderEvent
// como audit trail append-only intacto). Editar = PATCH message (carimba edited_at); excluir = delete
// LÓGICO (deleted_at). FKs compostas (tenant_id, work_order_id) → work_orders e (tenant_id,
// author_user_id) → users, RESTRICT (só no SQL da migration; modelo scalar-only, espelho dos vizinhos).
model WorkOrderComment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String    @db.Uuid
  work_order_id  String    @db.Uuid
  author_user_id String    @db.Uuid
  message        String
  edited_at      DateTime? @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([tenant_id, id])
  @@index([tenant_id, work_order_id])
  @@map("work_order_comments")
}

// Ω3F-5 (D-Ω3F-5-TAGASSIGN) — junção POLIMÓRFICA tag ↔ alvo (entity_type/entity_id). entity_type =
// "work_order_comment" agora; outros depois sem retrabalho. @@unique polimórfico → 409 duplicate.
// SEM FK nativa ao alvo polimórfico (integridade app-level: attach valida alvo/tag). Detach = HARD-delete.
// FK composta (tenant_id, tag_id) → tags RESTRICT (só no SQL da migration; modelo scalar-only).
model TagAssignment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  tag_id      String   @db.Uuid
  entity_type String
  entity_id   String   @db.Uuid
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenant_id, id])
  @@unique([tenant_id, entity_type, entity_id, tag_id])
  @@index([tenant_id, entity_type, entity_id])
  @@index([tenant_id, tag_id])
  @@map("tag_assignments")
}

// Ω2-b — Fornecedor (cadastro). Chave natural [tenant_id, name]; desativação lógica via is_active.
model Supplier {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  document   String?
  email      String?
  phone      String?
  address    String?
  category   String?
  notes      String?
  status     String    @default("active")
  is_active  Boolean   @default(true)
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  // Ω4C PR-05 — relação inversa (virtual) do fornecedor do abastecimento externo; a coluna FK vive
  // só em fuel_logs (D-Ω4C-FUEL-SUPPLIER).
  fuelLogs   FuelLog[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active])
  @@index([tenant_id, created_at])
  @@map("suppliers")
}

// Ω4-1 — Conta financeira (cadastro puro). kind ∈ {cash,bank,wallet} e currency ∈ {BRL} validados na
// aplicação. opening_balance é Decimal(12,2) ≥ 0 (saldo de abertura; saldo devedor é lançamento).
// A unicidade de NOME é PARCIAL (só entre contas ATIVAS) e vive SÓ no SQL da migration — o Prisma
// não expressa índice único parcial (WHERE is_active=true); por isso NÃO há @@unique([tenant_id,name]).
// Delete é LÓGICO: is_active=false + status='inactive'.
model FinancialAccount {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String           @db.Uuid
  name              String
  kind              String           @default("cash")
  currency          String           @default("BRL")
  opening_balance   Decimal          @default(0) @db.Decimal(12, 2)
  bank_name         String?
  agency            String?
  account_number    String?
  document          String?
  notes             String?
  status            String           @default("active")
  is_active         Boolean          @default(true)
  created_by        String?          @db.Uuid
  updated_by        String?          @db.Uuid
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  tenant            Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  financial_titles  FinancialTitle[]
  financial_entries FinancialEntry[]
  cheques           Cheque[]

  @@unique([tenant_id, id])
  @@index([tenant_id, is_active])
  @@index([tenant_id, created_at])
  @@map("financial_accounts")
}

// Ω4-2a — Título financeiro (a pagar/receber): agregado-núcleo do financeiro do tenant. Dinheiro
// DECIMAL(12,2). direction/party_type/status/currency são validados na aplicação (sem enum/CHECK, como
// status/priority da OS). competencia ('YYYY-MM') é DERIVADA de issue_date no servidor. party_id é
// polimórfico (customer/supplier/other) — SEM FK nativa ao alvo variável (integridade app-level, como
// TagAssignment). account_id (conta de liquidação prevista) e work_order_id (proveniência, populado no
// Ω4-3) usam FK composta (tenant_id, X) → (tenant_id, id) RESTRICT — nullable, então o Postgres só exige
// a FK quando a coluna não é NULL. paid_amount é DIRIGIDO por pagamentos (Ω4-4): nasce 0 aqui. Delete
// LÓGICO via deleted_at.
model FinancialTitle {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String                   @db.Uuid
  direction         String // receivable|payable (app-level)
  party_type        String // customer|supplier|other
  party_id          String?                  @db.Uuid // polimórfico: SEM FK nativa ao alvo variável
  party_name        String // snapshot obrigatório
  document          String? // rótulo NF-e/Fatura/Boleto (texto livre; NF-e não emitida no v1)
  category          String?
  description       String?
  amount            Decimal                  @db.Decimal(12, 2) // > 0
  currency          String                   @default("BRL") // allowlist {BRL} no v1
  issue_date        DateTime                 @default(now()) @db.Timestamptz(6)
  due_date          DateTime                 @db.Timestamptz(6) // obrigatório
  paid_amount       Decimal                  @default(0) @db.Decimal(12, 2) // <= amount; dirigido por pagamentos (Ω4-4)
  status            String                   @default("open") // open|scheduled|partially_paid|paid|in_dispute|cancelled
  competencia       String // 'YYYY-MM' derivado do issue_date (server-side)
  account_id        String?                  @db.Uuid // conta de liquidação prevista (FK composta)
  work_order_id     String?                  @db.Uuid // proveniência (setado no Ω4-3; sem idempotência aqui)
  service_quote_id  String?                  @db.Uuid // proveniência
  // Ω4C PR-02 (Contas a Pagar por origem) — par GENÉRICO de proveniência para fontes de frota
  // (fuel_log|maintenance_order|fine|insurance_policy). Coexiste com work_order_id/service_quote_id
  // (INTOCADOS). SEM FK nativa ao alvo variável (integridade app-level, como party_id). Nullable: título
  // avulso e faturamento OS não os populam. issue_date deriva a competência (chokepoint por período).
  source_type       String?                  // fuel_log|maintenance_order|fine|insurance_policy (app-level)
  source_id         String?                  @db.Uuid // id da entidade-fonte no MESMO tenant (sem FK nativa)
  client_action_id  String?
  created_by        String?                  @db.Uuid
  updated_by        String?                  @db.Uuid
  created_at        DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?                @db.Timestamptz(6)
  tenant            Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  account           FinancialAccount?        @relation(fields: [tenant_id, account_id], references: [tenant_id, id], onDelete: Restrict)
  work_order        WorkOrder?               @relation(fields: [tenant_id, work_order_id], references: [tenant_id, id], onDelete: Restrict)
  // Ω4-3 (D-Ω4-C1) — itens do Financeiro da OS carimbados por este título no faturamento.
  invoiced_items    WorkOrderFinancialItem[]
  // Ω4-4 — lançamentos de caixa que LIQUIDAM este título (title_id preenchido pela liquidação).
  financial_entries FinancialEntry[]

  // Ω4-3 (D-Ω4-C2) — a idempotência anti-refaturamento (no MÁX. 1 título ATIVO por tenant+OS+direção) é
  // um índice PARCIAL (WHERE deleted_at IS NULL AND work_order_id IS NOT NULL) que o Prisma NÃO modela;
  // vive só na migration 20260811000000, como o unique parcial de idempotência dos vizinhos.
  // Ω4C PR-02 — idempotência POR ORIGEM (no MÁX. 1 título ATIVO por tenant+source_type+source_id+direção):
  // outro índice PARCIAL (WHERE deleted_at IS NULL AND source_id IS NOT NULL) que o Prisma também NÃO
  // modela; vive só na migration 20260822000000 (financial_titles_source_direction_active_key).
  @@unique([tenant_id, id])
  @@index([tenant_id, direction, status])
  @@index([tenant_id, due_date])
  @@index([tenant_id, deleted_at])
  @@map("financial_titles")
}

// Ω4-2a — Fechamento de período financeiro (MÍNIMO). Só habilita o CHOKEPOINT assertPeriodOpen: toda
// escrita de título consulta (tenant_id, period=competencia); period 'closed' bloqueia a escrita (422
// period_closed). Nesta fatia NÃO há endpoint de escrita (fechar/reabrir vem no Ω4-6) — a tabela nasce
// vazia e o guard nunca bloqueia, mas a fiação é REAL.
model FinancialPeriodClose {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String    @db.Uuid
  period             String // 'YYYY-MM'
  status             String    @default("open") // open|closing|closed|reopened
  closed_at          DateTime? @db.Timestamptz(6)
  closed_by          String?   @db.Uuid
  // Ω4-6 — reabertura (reopened_*), janela de fechamento (closing_started_at, reservada) e o SNAPSHOT
  // financeiro congelado (JSONB: {latest, history} append-only — d/ataque). Todos nullable (ALTER aditivo).
  reopened_at        DateTime? @db.Timestamptz(6)
  reopened_by        String?   @db.Uuid
  reopen_reason      String?
  closing_started_at DateTime? @db.Timestamptz(6) // reservado p/ close assíncrono futuro (v1 não escreve)
  snapshot           Json?     @db.JsonB // resumo financeiro material congelado ao fechar (M1)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant             Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@unique([tenant_id, period])
  @@map("financial_period_closes")
}

// Ω4-4 — Lançamento de caixa (Caixa/Extrato) e LIQUIDAÇÃO de título. Dinheiro DECIMAL(12,2) > 0.
// direction (in|out) e payment_method (cash|pix|boleto|card|transfer|check) são validados na aplicação
// (sem enum/CHECK, como status da OS). competencia ('YYYY-MM') é DERIVADA de occurred_at no servidor
// (mesma deriveCompetencia do título). account_id é OBRIGATÓRIA (a conta que recebe/paga; FK composta
// RESTRICT). title_id é OPCIONAL: preenchido só pela liquidação (POST /financial-titles/:id/pay),
// captura em qual conta o dinheiro do título entrou. reversal_of aponta o lançamento original de um
// ESTORNO (contra-lançamento, direção invertida) — SEM FK nativa (app-level, como party_id do título).
// reconciled nasce false (conciliação é Ω4-5). Delete LÓGICO via deleted_at.
model FinancialEntry {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String           @db.Uuid
  account_id         String           @db.Uuid // conta obrigatória
  title_id           String?          @db.Uuid // liquidação de título (opcional)
  direction          String // in|out (app-level)
  amount             Decimal          @db.Decimal(12, 2) // > 0
  currency           String           @default("BRL")
  payment_method     String // cash|pix|boleto|card|transfer|check
  category           String?
  occurred_at        DateTime         @default(now()) @db.Timestamptz(6)
  competencia        String // 'YYYY-MM' derivada de occurred_at (server-side)
  description        String?
  reversal_of        String?          @db.Uuid // estorno = contra-lançamento aponta o original (P-Ω4-ESTORNO)
  reconciled         Boolean          @default(false) // Ω4-5 (nasce false)
  divergence_type    String? // value|date — "conciliado com ressalva" (app-level; Ω4-5)
  reconciliation_ref String? // referência opaca do extrato bancário (Ω4-5)
  reconciled_at      DateTime?        @db.Timestamptz(6) // carimbo server-side ao conciliar (Ω4-5)
  reconciled_by      String?          @db.Uuid // ator que conciliou (Ω4-5)
  client_action_id   String?
  created_by         String?          @db.Uuid
  updated_by         String?          @db.Uuid
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime?        @db.Timestamptz(6)
  tenant             Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  account            FinancialAccount @relation(fields: [tenant_id, account_id], references: [tenant_id, id], onDelete: Restrict)
  title              FinancialTitle?  @relation(fields: [tenant_id, title_id], references: [tenant_id, id], onDelete: Restrict)

  // Idempotência da liquidação (unique PARCIAL (tenant_id, title_id, client_action_id) WHERE
  // client_action_id IS NOT NULL AND deleted_at IS NULL) vive SÓ na migration 20260812000000 — o
  // Prisma não modela unique parcial (mesmo caso do índice anti-refaturamento do título Ω4-3).
  @@unique([tenant_id, id])
  @@index([tenant_id, account_id, occurred_at])
  @@index([tenant_id, title_id])
  @@index([tenant_id, deleted_at])
  @@index([tenant_id, reconciled])
  @@map("financial_entries")
}

// Ω4-7 — Cheque como INSTRUMENTO de pagamento com ciclo próprio (registered→deposited→cleared/bounced;
// registered→cancelled). direction (received|issued) e status são validados na aplicação (sem enum/CHECK,
// como status da OS). amount DECIMAL(12,2) > 0 (mesma faixa do lançamento → cheque registrado é sempre
// compensável). due_date ("bom para"/pré-datado) é MEMO — a compensação posta caixa na competência CORRENTE
// (server-now), nunca na due_date. account_id FK composta RESTRICT. cleared_entry_id/bounce_entry_id apontam
// os lançamentos postados na compensação/devolução (app-level, SEM FK nativa — o lançamento vive no seu
// próprio módulo). Delete LÓGICO via deleted_at.
model Cheque {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String           @db.Uuid
  account_id       String           @db.Uuid // conta de depósito (received) / pagadora (issued)
  direction        String // received|issued (app-level)
  cheque_number    String
  bank             String
  amount           Decimal          @db.Decimal(12, 2) // > 0
  currency         String           @default("BRL")
  due_date         DateTime?        @db.Date // "bom para"/pré-datado — MEMO (não entra na competência)
  status           String           @default("registered") // registered|deposited|cleared|bounced|cancelled
  cleared_entry_id String?          @db.Uuid // lançamento postado ao compensar (app-level)
  bounce_entry_id  String?          @db.Uuid // contra-lançamento postado ao devolver-após-compensar (app-level)
  bounce_reason    String? // motivo da devolução (auditoria)
  notes            String?
  created_by       String?          @db.Uuid
  updated_by       String?          @db.Uuid
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?        @db.Timestamptz(6)
  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  account          FinancialAccount @relation(fields: [tenant_id, account_id], references: [tenant_id, id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@index([tenant_id, account_id, due_date])
  @@index([tenant_id, status])
  @@index([tenant_id, deleted_at])
  @@map("cheques")
}

// Ω2-d — Tag (marcador/etiqueta). Chave natural [tenant_id, name]; desativação lógica via is_active.
// color opcional em hex (#RRGGBB), validado na aplicação.
model Tag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  name        String
  color       String?
  description String?
  is_active   Boolean  @default(true)
  created_by  String?  @db.Uuid
  updated_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active])
  @@index([tenant_id, created_at])
  @@map("tags")
}

// Ω2-d — POI (ponto de interesse geográfico). Chave natural [tenant_id, name]; latitude/longitude
// NUMERIC(10,7) obrigatórios, validados pelo predicado do mapa Ω1 (finito, |lat|<=90, |lng|<=180,
// sem sentinela 0/0). Desativação lógica via is_active.
model Poi {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  category   String?
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  address    String?
  is_active  Boolean  @default(true)
  created_by String?  @db.Uuid
  updated_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, id])
  @@unique([tenant_id, name])
  @@index([tenant_id, is_active])
  @@index([tenant_id, created_at])
  @@map("pois")
}

// Ω2-e — Parâmetro (cadastro key-value administrativo do tenant). Chave natural [tenant_id, key]
// (upsert por chave). value é @db.Text e pode conter JSON serializado. Sem delete físico: upsert
// sobrescreve o valor. Território de admin (RBAC tenant_settings:read/update).
model TenantSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  key         String
  value       String   @db.Text
  category    String?
  description String?
  updated_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, key])
  @@unique([tenant_id, id])
  @@index([tenant_id, category])
  @@map("tenant_settings")
}

// Ω2-c — Profissional (perfil profissional do operador de campo). Extensão 1-1 de User (unique
// [tenant_id, user_id] → 409 duplicate_profile). Dado sensível LGPD: CNH e consentimento de rastreamento.
// FK composta (tenant_id, user_id) → users(tenant_id, id) ON DELETE Cascade (apagar o usuário remove o
// perfil). user_id imutável no update. Desativação lógica via is_active.
model OperatorProfile {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String    @db.Uuid
  user_id             String    @db.Uuid
  full_name           String?
  cnh_number          String?
  cnh_category        String?
  cnh_expires_at      DateTime? @db.Timestamptz(6)
  tracking_consent    Boolean   @default(false)
  tracking_consent_at DateTime? @db.Timestamptz(6)
  phone               String?
  notes               String?
  is_active           Boolean   @default(true)
  created_by          String?   @db.Uuid
  updated_by          String?   @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant              Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  user                User      @relation(fields: [tenant_id, user_id], references: [tenant_id, id], onDelete: Cascade)
  // Ω4C PR-03 — Extrato do profissional (razão financeiro POR profissional). onDelete Restrict: um perfil
  // com lançamentos no extrato não é apagado (a trilha financeira é imutável — RN-EXT-01).
  professional_statement_entries ProfessionalStatementEntry[]
  // Ω4C PR-07 — Multas em que este profissional é o condutor responsável (D-Ω4C-MULSEG-RESPONSIBLE-MODEL).
  // onDelete Restrict (na FK do lado Fine): perfil com multa atribuída não é apagado (a atribuição roteia
  // a multa ao extrato do profissional — RN-MUL-01).
  fines                          Fine[]
  // Ω4C PR-09 — Danos em que este profissional é o responsável (D-Ω4C-DANO-MODEL). onDelete Restrict (na
  // FK do lado Damage): perfil com dano atribuído não é apagado (o desconto roteia ao extrato do profissional).
  damages                        Damage[]
  // Ω4C PR-08 — movimentos de estoque em CUSTÓDIA deste profissional (custody_type=professional). onDelete
  // Restrict (na FK do lado StockMovement): um profissional que AINDA detém itens não é apagado — "desvincular
  // devolve à base" antes de remover (D-Ω4C-INV-CUSTODY-REF-TYPED).
  stock_custody                  StockMovement[] @relation("StockMovementCustodyOperator")
  // Ω4C PR-12 — Telemetria do app deste profissional (heartbeat/acessos/recusas). onDelete Cascade (na FK
  // do lado TelemetryEvent): apagar o perfil apaga a sua telemetria (direito ao esquecimento LGPD).
  telemetry_events               TelemetryEvent[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, user_id])
  @@index([tenant_id, is_active])
  @@index([tenant_id, created_at])
  @@map("operator_profiles")
}

// Ω4C PR-12 (D-Ω4C-TELE-MODEL) — Telemetria do app AutEM Mobile: fonte de verdade de acessos, heartbeat
// GPS, km diário (DERIVADO on-read via haversine), recusas e dispositivos. Model NOVO (não estende
// field_operator_locations, que é a "última posição viva" do Mapa Ω1 — coexistência D-007). Enums em
// INGLÊS (labels PT-BR no DTO), SEM CHECK de enum no banco: event_type heartbeat|app_connect|
// app_disconnect|service_refusal; signal_type wifi|mobile|none. lat/lng NULL — só o heartbeat CONSENTIDO
// grava coordenada (consent-gate LGPD D-Ω4C-TELE-CONSENT, checado ANTES de persistir). Idempotência
// persistente por UNIQUE (tenant_id, operator_profile_id, client_action_id) — D-Ω4C-TELE-IDEMP. km NÃO
// tem coluna (Decimal(10,1) derivado). O índice/constraints extra vivem na migration 20260831000000.
model TelemetryEvent {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String          @db.Uuid
  operator_profile_id String          @db.Uuid
  event_type          String // heartbeat|app_connect|app_disconnect|service_refusal (app-level)
  captured_at         DateTime        @db.Timestamptz(6)
  received_at         DateTime        @default(now()) @db.Timestamptz(6)
  lat                 Float? // só heartbeat consentido (CHECK ±90 na migration)
  lng                 Float? // só heartbeat consentido (CHECK ±180 na migration)
  accuracy_m          Float? // precisão do fix (CHECK ≥ 0)
  speed_kmh           Float? // velocidade instantânea reportada (CHECK ≥ 0)
  battery_pct         Int? // 0..100 (CHECK na migration)
  signal_type         String? // wifi|mobile|none (app-level)
  app_version         String?
  device_model        String?
  sdk_int             Int?
  client_action_id    String
  refusal_reason      String? // só service_refusal
  work_order_id       String?         @db.Uuid // contexto da recusa (SEM FK dura em v1)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  tenant              Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  operator_profile    OperatorProfile @relation(fields: [tenant_id, operator_profile_id], references: [tenant_id, id], onDelete: Cascade, map: "telemetry_events_operator_fkey")

  @@unique([tenant_id, id])
  @@unique([tenant_id, operator_profile_id, client_action_id], map: "telemetry_events_idem_key")
  @@index([tenant_id, operator_profile_id, captured_at], map: "telemetry_events_profile_captured_idx")
  @@index([tenant_id, event_type, captured_at], map: "telemetry_events_type_captured_idx")
  @@map("telemetry_events")
}

// Ω4C PR-03 (D-Ω4C-EXTRATO-MODEL) — Extrato do profissional: razão financeiro POR profissional. TABELA ÚNICA,
// 1 linha por PARCELA, agrupada por group_id (o "lançamento" é lógico: entry_type/direction/description/source/
// installment_total viram snapshot repetido e imutável em cada linha-irmã). O extrato do AutEM É uma lista de
// parcelas datadas com saldo corrente → cada parcela = 1 movimento; a trava/retirada RN-EXT-01 opera no grupo.
// Enums em INGLÊS (labels PT-BR na fronteira do DTO): entry_type damage|fine|remuneration|adjustment; direction
// debit(desconto)|credit(provento); status pending|settled|cancelled; source_type damage|fine|remuneration|manual.
// SEM CHECK no banco (validado na app). Convenção (D-Ω4C-EXTRATO-DIRECTION): Saldo = Σcredit − Σdebit (DERIVADO
// server-side). amount Decimal(12,2) > 0 = valor DA PARCELA. source_id SEM FK nativa (app-level, como party_id).
model ProfessionalStatementEntry {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String          @db.Uuid
  operator_profile_id String          @db.Uuid
  group_id            String          @db.Uuid
  entry_type          String // damage|fine|remuneration|adjustment (app-level)
  direction           String // debit|credit (app-level)
  description         String?
  amount              Decimal         @db.Decimal(12, 2) // valor DA PARCELA (> 0)
  currency            String          @default("BRL") // allowlist {BRL} no v1
  installment_number  Int // 1..installment_total
  installment_total   Int // >= 1
  due_date            DateTime        @db.Timestamptz(6)
  competencia         String // 'YYYY-MM' derivada de due_date (server-side)
  status              String          @default("pending") // pending|settled|cancelled
  settled_at          DateTime?       @db.Timestamptz(6) // setado pela liquidação em folha (PR-14/15)
  settlement_ref      String?         @db.Uuid
  source_type         String? // damage|fine|remuneration|manual (nullable — AJUSTE = manual)
  source_id           String?         @db.Uuid // id da entidade-fonte no MESMO tenant (SEM FK nativa; foundation-ready)
  client_action_id    String?
  created_by          String?         @db.Uuid
  updated_by          String?         @db.Uuid
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?       @db.Timestamptz(6) // soft-delete = "retirar do extrato"
  tenant              Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  operator_profile    OperatorProfile @relation(fields: [tenant_id, operator_profile_id], references: [tenant_id, id], onDelete: Restrict, map: "professional_statement_entries_operator_fkey")

  // O índice PARCIAL de idempotência de origem (tenant_id, source_type, source_id, installment_number) WHERE
  // deleted_at IS NULL AND source_id IS NOT NULL (foundation-ready p/ as integrações Multa/Dano/Remuneração)
  // vive só na migration 20260823000000 (Prisma não modela índice parcial) — espelha financial_titles.
  @@unique([tenant_id, id])
  @@unique([tenant_id, group_id, installment_number], map: "professional_statement_entries_group_installment_key")
  @@index([tenant_id, operator_profile_id, due_date], map: "professional_statement_entries_profile_due_idx")
  @@index([tenant_id, status])
  @@map("professional_statement_entries")
}

model Team {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String       @db.Uuid
  name           String
  leader_user_id String?      @db.Uuid
