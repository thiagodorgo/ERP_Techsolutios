  @@index([tenant_id, status])
  @@index([tenant_id, vehicle_id])
  @@index([tenant_id, work_order_id])
  @@index([tenant_id, responsible_operator_profile_id], map: "damages_responsible_operator_idx")
  @@index([tenant_id, created_at])
