PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Controla o backend de persistencia do Core SaaS.
# memory: padrao atual. Usa store em memoria. Nao exige DATABASE_URL.
# prisma: usa PostgreSQL via Prisma. Exige DATABASE_URL valido e migrations aplicadas.
#         Ainda e modo controlado/experimental ate a migracao completa das rotas.
CORE_SAAS_PERSISTENCE="memory"

# Exemplo local de desenvolvimento. Nao use esta DATABASE_URL como segredo de producao.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_techsolutions?schema=public"
REDIS_URL="redis://localhost:6379"

# Senha local de desenvolvimento para o admin demo criado pelo seed.
# Nunca use este valor em producao; defina um segredo proprio fora do repositorio.
DEMO_ADMIN_PASSWORD="ChangeMe123!"

# JWT local/dev. Troque em qualquer ambiente compartilhado/producao.
# Nao use um JWT_SECRET real em arquivos versionados.
JWT_SECRET="change-me-in-local-development"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="change-me-refresh-in-local-development"
JWT_REFRESH_EXPIRES_IN="7d"

CHECKLIST_STORAGE_PROVIDER="local"
CHECKLIST_STORAGE_LOCAL_DIR="storage/checklist-attachments"
CHECKLIST_STORAGE_MAX_FILE_SIZE_MB=10
CHECKLIST_STORAGE_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,application/pdf"
CHECKLIST_STORAGE_S3_BUCKET=""
CHECKLIST_STORAGE_S3_REGION=""
CHECKLIST_STORAGE_S3_ENDPOINT=""
CHECKLIST_STORAGE_S3_FORCE_PATH_STYLE=true
CHECKLIST_STORAGE_S3_ACCESS_KEY_ID=""
CHECKLIST_STORAGE_S3_SECRET_ACCESS_KEY=""
CHECKLIST_STORAGE_S3_PREFIX="checklist-attachments"

# Aliases legados ainda aceitos para compatibilidade local/testes.
CHECKLIST_ATTACHMENT_STORAGE_DRIVER="local"
CHECKLIST_ATTACHMENT_STORAGE_PATH="storage/checklist-attachments"
CHECKLIST_ATTACHMENT_MAX_SIZE_MB=10
CHECKLIST_ATTACHMENT_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,application/pdf"
# B-O6R-07b: as duas allowlists acima so aceitam tipos que o sniff de assinatura sabe VERIFICAR nos
# bytes (image/jpeg, image/png, image/webp, application/pdf). Ligar image/svg+xml, text/html ou
# image/heic aqui faz o boot FALHAR — o gate nomeia a entrada e qual das duas chaves a trouxe.

# B-O6R-07b (Omega6R-SEC-004) — scanner de conteudo de upload.
# "noop" so fora de producao (responde "limpo" para qualquer byte — e o proprio achado).
# Em producao (staging incluso, NODE_ENV=production) o default e "unavailable": todo upload responde
# 503 e nada e gravado, ate existir antivirus real (P-O6R-B07B-SCANNER-AV-REAL). "noop" com
# NODE_ENV=production e RECUSADO no boot; nao ha valvula.
EVIDENCE_SCANNER="noop"

# Configuracao passiva para futura integracao AWS CUR real.
# Esta branch usa importacao local/mock e nao exige credenciais AWS.
AWS_CUR_IMPORT_ENABLED=false
AWS_CUR_S3_BUCKET=""
AWS_CUR_S3_PREFIX=""
AWS_CUR_S3_REGION=""
AWS_CUR_ATHENA_DATABASE=""
AWS_CUR_ATHENA_WORKGROUP=""
AWS_CUR_ATHENA_OUTPUT_LOCATION=""

# CORS allowlist (CSV de origens). Vazio em dev/test = permissivo (reflete a origem da requisicao).
# Em PRODUCAO o gate do env.ts EXIGE allowlist explicita e SEM curinga '*' (fail-closed). Ex. prod:
#   CORS_ORIGIN="https://app.suaempresa.com,https://admin.suaempresa.com"
CORS_ORIGIN="http://localhost:5173"

# Worker de jobs in-process (Ω4C PR-04). Em DEV fica DESLIGADO: com false o loop de jobs nao sobe, entao
# CI e testes que importam app.ts nunca disparam o scheduler. Em PRODUCAO o gate G3 do env.ts (B-O6R-05,
# achado Omega6R-DIN-006) EXIGE true: sem o worker, diaria de patio, reconciliacao de custodia e
# notificacao legal nunca sao materializadas. O boot em producao reprova se esta flag nao vier true.
JOBS_WORKER_ENABLED=false

# ── O QUE PRODUCAO EXIGE E NAO TEM VALOR AQUI (B-O6R-05) ────────────────────────────────────────────────
# Os gates de producao do env.ts exigem, alem do que ja esta acima:
#   CORE_SAAS_PERSISTENCE → tem de ser "prisma" (com "memory" o agregado core-saas — organizacoes,
#                           usuarios, papeis/vinculos e a auditoria desse agregado — some no restart)
#   DATABASE_URL          → obrigatoria e nao-vazia
#   REDIS_URL             → obrigatoria e FORA do loopback (localhost/127.0.0.1 = fila isolada no
#                           conteiner, perdida no restart)
#   JOBS_WORKER_ENABLED   → obrigatoriamente true
# E os cinco do portal publico (Omega5P), que NAO tem valor de exemplo aqui de proposito — sao segredo ou
# id de organizacao real, injetados fora do repositorio (GitHub Environments / secrets do provedor):
#   PORTAL_SESSION_SECRET → segredo PROPRIO da sessao do owner-portal (≠ JWT_SECRET do ERP)
#   PORTAL_AUTHORITY_SESSION_SECRET → segredo PROPRIO da sessao do authority-portal (≠ ERP e ≠ owner)
#   PORTAL_LOG_SECRET     → segredo do HMAC do PortalAccessLog (≠ JWT_REFRESH_SECRET)
#   PORTAL_TENANT_ID      → binding de organizacao do deploy do portal
#   PORTAL_CORS_ORIGIN    → allowlist https:// da origem do portal (o gate rejeita vazio/'*')

# Guarda de seed (P-SAN-SEED-GUARD): seeds sao de DEMONSTRACAO e nunca rodam em producao. Com
# NODE_ENV=production, `npm run db:seed*` aborta salvo opt-in ESTRITO one-shot ALLOW_PROD_SEED=1
# (inline no unico comando de bootstrap; remover em seguida — nunca persistir). Default: nao setar.
# ALLOW_PROD_SEED=

# Backup de banco (Ω-INFRA-4) — ativacao viva (bucket S3 real, creds) e hand-off humano; aqui tudo VAZIO.
# O backup usa pg_dump -Fc -> S3 (bucket DEDICADO, PRIVADO, SSE). Creds AWS pela cadeia padrao do SDK
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY do Environment) — NUNCA versionadas. Em producao o endpoint e https.
BACKUP_S3_BUCKET=""
BACKUP_S3_PREFIX="db-backups"
BACKUP_S3_REGION=""
BACKUP_S3_ENDPOINT=""
BACKUP_S3_FORCE_PATH_STYLE="false"

# Frontend local. true usa mocks da Console da Plataforma; false usa a API real.
VITE_USE_MOCKS="true"
VITE_DEFAULT_TENANT_ID=""
VITE_GOOGLE_MAPS_API_KEY=""

# E2E local com Playwright. Overrides opcionais; os defaults ficam na config.
E2E_API_PORT=3200
E2E_FRONTEND_PORT=5173
E2E_DEMO_ADMIN_EMAIL="admin.demo@example.com"
E2E_PLATFORM_EMAIL="platform.admin@erp.local"
E2E_PLATFORM_PASSWORD="platform-admin-dev-password"

# Ω1b-2 — Geocodificação de OS (Nominatim), apenas DEV. DESLIGADA por default (noop = sem rede).
# Em produção, o uso da instância pública do Nominatim é PROIBIDO (política de uso) — mantenha
# GEOCODING_ENABLED=false ou aponte NOMINATIM_BASE_URL para um provedor próprio/self-host.
GEOCODING_ENABLED=false
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org/search"
NOMINATIM_USER_AGENT="ERP-Techsolutions/1.0 (+contato-do-operador)"
NOMINATIM_COUNTRY_CODES=br
NOMINATIM_MIN_INTERVAL_MS=1100
NOMINATIM_TIMEOUT_MS=5000

# Nunca versione o arquivo .env real.

